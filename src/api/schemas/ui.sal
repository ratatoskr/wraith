// The overlay: ImGui drawing helpers, toasts, the cursor and game input, and Wraith's own UI.
// ImGui itself is the `imgui` area.

namespace Wraith;

namespace Toast {
    enum Kind : u8 { info, success, warning, failure }
}

struct Toast {
    Kind style;
    // Empty shows the plugin's name
    string title;
    string text;
    // Paused while hovered. 0 stays till clicked or dismissed.
    f32 seconds;
}

error DialogError { Failed = 1 }

namespace WorkbenchPanel {
    // On the Workbench's own thread, not the render or game thread. Read what game-thread code left
    // and queue changes for it, rather than calling into the game.
    fn void Draw();

    // `top` is with the documents, `bottom` with Addresses, `left` with Search
    enum Place : u8 { top, bottom, left }

    struct Options {
        // Its tab's label
        string title;
        // What it is, like `sheets`. With `id`, how Wraith remembers where it was moved. Empty uses the title
        string kind;
        // Which one of its kind, for several at once, like an address. Can be empty
        string id;
        // Where it goes the first time it shows. Closed, it comes back from View, or with `focus`
        Place place;
        // Lower comes first among tabs in the same place. Wraith's own are 100 apart, from 100, and 0 is after them
        i32 order;
    }
}

// A panel of the plugin's in the Workbench.
trait WorkbenchPanel {
    bool isOpen();
    // Opens it and brings its tab to the front
    void focus();
    // Waits for a draw under way, except from inside a draw or a script. Fine to call twice.
    void remove();
}

namespace Window {
    // Draws a window's contents, on the render thread between its Begin and End.
    fn void Draw();

    struct Options {
        // Also tells it apart from the plugin's other windows
        string title;
        // Starting size, unscaled. Zero lets ImGui pick
        ImVec2 size;
        ImVec2 min_size;
        // Zero for no limit that way
        ImVec2 max_size;
        ImGuiWindowFlags flags;
        // No close button in its title bar
        bool no_close;
        // Esc doesn't close it
        bool keep_on_escape;
        // An entry under the plugin's button on the overlay's bar that toggles it. Empty for none
        string menu;
        // The plugin's Settings button on the Mods page opens it
        bool settings;
    }
}

// A window of the plugin's on the overlay. It starts closed.
trait Window {
    bool isOpen();
    void setOpen(bool open);
    // Opens it and brings it to the front
    void focus();
    // A dot in its title, for unsaved changes
    void setUnsaved(bool unsaved);
    // Fine to call twice, or from inside its draw.
    void remove();
}

// An entry under the plugin's own button on the overlay's bar.
trait MenuItem {
    bool isOpen();
    void setOpen(bool open);
    // Fine to call twice.
    void remove();
}

namespace Gizmo {
    enum Tool : u8 { move, rotate, scale }
}

// Handles over the game, drawn with the game plugin's camera. Only the last shown one shows. Any
// thread. Draggable while the overlay has the mouse.
trait Gizmo {
    // Shows it in front of any other. Needs a `place`.
    void show();
    // Till the next `show`. Whichever was shown before shows again.
    void hide();
    // Its world transform, each tick, row-vector. Ignored while it's dragged.
    void place(Mat4 world);
    void setTool(Tool tool);
    // Along the world's axes rather than its own
    void setWorldAxes(bool on);
    // Where it's been dragged to since last asked, or null, including a drag's end. Move yours there.
    ?Mat4 moved();
    bool dragging();
    // The mouse was on it last frame, so a click there is for it.
    bool hovered();
    // Fine to call twice.
    void remove();
}

namespace Ui {
    enum CursorHint : u8 { auto, visible, hidden }

    // What the overlay can take from the game.
    enum InputDevice : u8 { keyboard, mouse, gamepad }

    struct SortSpec {
        // In the order its columns were set up
        i32 column;
        bool descending;
    }

    struct FileDialog {
        bool save;
        string title;
        string folder;
        string file_name;
        string kind;
        string extension;
    }

    struct FolderDialog {
        string title;
        string folder;
    }

    // One row of a clipped list.
    fn void ClipRow(u32 index);

    // The Mods page's Settings button, on the render thread inside a frame.
    fn void OpenSettings();
}

// Plugins built against an older order still work, since tables are matched by name
trait Ui {
    // The overlay

    // False in games whose graphics it can't hook
    bool available();
    // The game window's size in pixels. Zero outside a draw callback.
    ImVec2 displaySize();

    // Drawing, only in a draw callback

    // The current window's, foreground's or background's. Null outside a draw callback.
    ?ImDrawList windowDrawList();
    ?ImDrawList foregroundDrawList();
    ?ImDrawList backgroundDrawList();
    // Any length. Keeps the edit by `label` while typing, so `text` only shows once it's left.
    string inputText(cstring label, string text, ImGuiInputTextFlags flags);
    string inputMultiline(cstring label, string text, ImVec2 size, ImGuiInputTextFlags flags);
    // Text with a copy button
    void copyableText(cstring id, string text);
    // Calls `row` for each on-screen row of `count` equal-height rows
    void clip(u32 count, ClipRow row);
    // How the current table's sorted, or null if the user hasn't sorted it.
    ?SortSpec tableSortedBy();
    // A schema struct as live controls, shaped by [Label], [Range], [ReadOnly] and [Hidden]. 0
    // `address` uses its [Instance]. False if it's unknown or not made yet
    bool editStruct(string type, usize address);

    // Toasts

    // Its id, or 0 without an overlay
    u32 toast(Toast toast);
    // False once it's gone
    bool updateToast(u32 id, Toast toast);
    void dismissToast(u32 id);

    // The cursor and the game's input

    // While any plugin asks
    void showCursor(bool show);
    void setCursorHint(CursorHint hint);
    // For games that leave the cursor free, like FFXIV: Wraith only takes input over its windows.
    // For game plugins; the player's setting can override
    void setMouseFree(bool free);
    // Hides it from the game while any plugin asks
    void takeInput(InputDevice device, bool take);
    bool inputTaken(InputDevice device);
    // Locks the cursor hidden in the window centre from next frame while any plugin asks, for mouse-look.
    void holdMouse(bool hold);
    // Pixels moved since last frame while held, right and down positive. In a draw callback.
    Point mouseMotion();

    // Handles for moving, turning or scaling something. Gone with the plugin. Any thread.
    Gizmo addGizmo();

    // Wraith's own UI

    // Where a plugin can add to Wraith's UI, and what each place takes. Any thread.
    []Slot.Info slots();
    // Adds `draw` to a slot, placed as `placement` says. Gone with the plugin. Any thread.
    Contribution!SlotError contribute(Slot.Placement placement, keep Contribution.Draw draw);
    // Drawn by `draw` while open; close, Esc, menu entry and Settings button all just work. Gone with
    // the plugin. Any thread.
    Window addWindow(Window.Options options, keep Window.Draw draw);
    // Under the plugin's own button on the overlay's bar
    MenuItem addMenuItem(string label);
    // What the plugin's Settings button on the Mods page does, else Wraith's Settings. Replaces any
    // earlier one. Gone with the plugin
    void onOpenSettings(keep OpenSettings open);

    // The Workbench

    // A tab of its own in the Workbench, drawn by `draw` on the Workbench's thread while showing. For
    // tabs inside it, draw them with ImGui's tab bars. Gone with the plugin. Any thread. The same as
    // contributing to the `workbench` slot, with `kind/id` as its id
    WorkbenchPanel addWorkbenchPanel(WorkbenchPanel.Options options, keep WorkbenchPanel.Draw draw);
    // Opens the Workbench's Classes on a C# class by full name. Any thread.
    void showClass(string class_name);

    // Windows' own dialogs. The full path, or null if cancelled. One at a time per plugin.
    async ?string!DialogError pickFile(FileDialog options);
    async ?string!DialogError pickFolder(FolderDialog options);

    // For native code that binds Dear ImGui itself

    // A dcimgui function's address by name, or 0
    usize imguiProc(string name);
    // The hosted Dear ImGui version, like 19250
    u32 imguiVersion();
}
