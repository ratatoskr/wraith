// The overlay: drawing with Dear ImGui in a frame callback, toasts, the cursor and the game's input,
// and the overlay's menu. ImGui itself is the `imgui` area, from imgui.sal.

enum CursorHint : u8 { auto, visible, hidden }

// What the overlay can take from the game.
enum InputDevice : u8 { keyboard, mouse, gamepad }

enum ToastKind : u8 { info, success, warning, failure }

struct Toast {
    ToastKind kind;
    // Empty shows the plugin's name
    string title;
    string text;
    // Not counting while it's hovered. 0 keeps it up till it's clicked or dismissed.
    f32 seconds;
}

// How a table's sorted.
struct SortSpec {
    // In the order its columns were set up
    i32 column;
    bool descending;
}

error DialogError { Failed = 1 }

// A file to open.
struct FileDialog {
    bool save;
    string title;
    string folder;
    string file_name;
    string kind;
    string extension;
}

// A folder to open.
struct FolderDialog {
    string title;
    string folder;
}

// One row of a clipped list.
fn void ClipRow(u32 index);

// What the Mods page's Settings button calls, on the render thread inside a frame. Open your
// settings window from it.
fn void OpenSettings();


// An entry under the plugin's own button on the overlay's bar, which opens and closes something of
// the plugin's.
trait MenuItem {
    bool isOpen();
    void setOpen(bool open);
    // Takes it out of the menu. Fine to call twice.
    void remove();
}

// Plugins built against an older order still work, since tables are matched up by name
trait Ui {
    // The overlay

    // Whether there's an overlay to draw in, which games whose graphics it can't hook don't have
    bool available();
    // The game window's size in pixels. Zero outside a frame callback.
    ImVec2 displaySize();

    // Drawing, only in a frame callback

    // Where the current window draws, or everything in front of or behind the windows. Null
    // outside a frame callback.
    ?ImDrawList windowDrawList();
    ?ImDrawList foregroundDrawList();
    ?ImDrawList backgroundDrawList();
    // A text box of any length, which gives what's in it now. While it's being typed in it keeps the
    // edit, by `label`, so `text` only shows once it's left.
    string inputText(cstring label, string text, ImGuiInputTextFlags flags);
    string inputMultiline(cstring label, string text, ImVec2 size, ImGuiInputTextFlags flags);
    // Text with a button to copy it
    void copyableText(cstring id, string text);
    // Calls `row` for each of `count` rows of the same height that's on screen, for long lists
    void clip(u32 count, ClipRow row);
    // How the current table's sorted, once the user's sorted it. Null otherwise.
    ?SortSpec tableSortedBy();
    // A struct from the plugin's schemas as controls, read and written live. [Label], [Range],
    // [ReadOnly] and [Hidden] on its fields change how they show. 0 for `address` uses its
    // [Instance]. False if the schemas don't have it, or the game hasn't made it yet
    bool editStruct(string type, usize address);

    // Toasts

    // Gives its id, or 0 without an overlay
    u32 toast(Toast toast);
    // False once it's gone
    bool updateToast(u32 id, Toast toast);
    void dismissToast(u32 id);

    // The cursor and the game's input

    // Shows the mouse cursor while any plugin asks
    void showCursor(bool show);
    void setCursorHint(CursorHint hint);
    // Keeps the game from seeing it while any plugin asks
    void takeInput(InputDevice device, bool take);
    bool inputTaken(InputDevice device);
    // Keeps the cursor still and hidden in the middle of the game window while any plugin asks,
    // from the next frame, for turning something with the mouse. Lets go where it was.
    void holdMouse(bool hold);
    // How far the mouse was pushed since last frame while it's held, in pixels. Right and down are
    // positive. In a frame callback.
    Point mouseMotion();

    // Wraith's own UI

    // Under the plugin's own button on the overlay's bar, named after it
    MenuItem addMenuItem(string label);
    // What the plugin's Settings button on the Mods page does, like opening a window of its own.
    // Without one, it shows the plugin's settings in Wraith's Settings. A second call replaces the
    // first, and it's gone with the plugin
    void onOpenSettings(keep OpenSettings open);

    // Windows' own dialogs, over the game. The full path, or null if it's cancelled. The game keeps
    // running while it's open. One at a time per plugin, another fails while one's up.
    async ?string!DialogError pickFile(FileDialog options);
    async ?string!DialogError pickFolder(FolderDialog options);

    // Native code that binds Dear ImGui itself

    // A dcimgui function's address by name, or 0
    usize imguiProc(string name);
    // The Dear ImGui it hosts, like 19250
    u32 imguiVersion();
}
