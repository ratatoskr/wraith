// Locks shared between plugins, threads, tasks and scripts. `lock` never blocks, and a freed lock goes
// to the longest waiter. Locks, holds and waits go with their plugin. Any thread.

namespace Wraith;

error SyncError {
    // This plugin has it already. Not reentrant.
    AlreadyHeld = 1,
    Failed,
}

namespace Sync {
    // Share through a service; other plugins lock it through their own `sync`.
    trait Lock {
        // Whether anyone has it, for showing. May change straight after.
        bool held();
    }
}

trait Sync {
    // Goes when this plugin does.
    Lock newLock();
    // Settles once it's this plugin's. Fails with Salamander's built-in `Gone` if the lock goes first.
    async void!SyncError lock(Lock lock);
    // Takes it if nobody has it.
    bool tryLock(Lock lock);
    // Hands it to the longest waiter. Nothing if this plugin doesn't have it.
    void unlock(Lock lock);
}
