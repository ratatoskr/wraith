// Maths types shared by every schema, tuft's in Zig. Row-major for row vectors (`p * m`). Radians.

namespace Wraith;

struct Vec2 { f32 x; f32 y; }

struct Vec3 { f32 x; f32 y; f32 z; }

struct Vec4 { f32 x; f32 y; f32 z; f32 w; }

// `w` is the real part.
struct Quat { f32 x; f32 y; f32 z; f32 w; }

// `m[row * 4 + column]`, translation in the last row.
struct Mat4 { f32[16] m; }
