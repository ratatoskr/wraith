// Keys, buttons and the mouse, going by the game window's messages, and keybinds.

namespace Wraith;

// Physical keys, named for the US layout. Sided keys always report their side. `gamepad_a` is the
// bottom face button on any controller.
enum Key : u8 {
    tab, left, right, up, down, page_up, page_down, home, end, insert, delete, backspace, space, enter, escape,
    left_ctrl, left_shift, left_alt, left_super, right_ctrl, right_shift, right_alt, right_super, menu,
    digit_0, digit_1, digit_2, digit_3, digit_4, digit_5, digit_6, digit_7, digit_8, digit_9,
    a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w, x, y, z,
    f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20, f21, f22, f23, f24,
    apostrophe, comma, minus, period, slash, semicolon, equal, left_bracket, backslash, right_bracket, grave,
    caps_lock, scroll_lock, num_lock, print_screen, pause,
    keypad_0, keypad_1, keypad_2, keypad_3, keypad_4, keypad_5, keypad_6, keypad_7, keypad_8, keypad_9,
    keypad_decimal, keypad_divide, keypad_multiply, keypad_subtract, keypad_add, keypad_enter,
    browser_back, browser_forward, oem_102,
    gamepad_a, gamepad_b, gamepad_x, gamepad_y, gamepad_left_shoulder, gamepad_right_shoulder,
    gamepad_left_trigger, gamepad_right_trigger, gamepad_dpad_up, gamepad_dpad_down, gamepad_dpad_left, gamepad_dpad_right,
    gamepad_start, gamepad_back, gamepad_left_stick, gamepad_right_stick,
}

enum MouseButton : u8 { left, right, middle, x1, x2 }

// Either side.
bitfield Mods : u8 { bool ctrl; bool shift; bool alt; bool super; }

// A key with exactly these modifiers held. The key can't be a modifier, and controller buttons take
// no modifiers.
struct Chord { Key key; Mods mods; }

// In the game window's client coords.
struct Point { i32 x; i32 y; }

error KeybindError { Unavailable = 1, AlreadyBound, InvalidChord, Failed }

namespace Keybind {
    enum Phase : u8 { pressed, released }

    // On the render thread.
    fn void Fired(Phase phase);
}

trait Keybind {
    // Its keys from now on, any of which does it. Saved, like picking them in Settings. Empty
    // leaves it without one.
    void!KeybindError rebind([]Chord chords);
    // Its keys stay saved for next time.
    void unbind();
    // What it's on now, the player's picks if they made some. Empty without a key. Good till the
    // thread's next call into Wraith.
    []Chord chords();
    // Its next press, carrying on on the thread that asked. Fails with Unavailable once it's
    // unbound.
    async void!KeybindError next();
}

namespace Input {
    struct Action {
        // Unique for the plugin. Letters, digits, `_`, `-` and `.`.
        string id;
        // What Settings lists it as
        string name;
        // The default. Whoever plays can pick others in Settings, and theirs win.
        Chord chord;
        // More that do the same by default, like a controller button. Up to 3.
        []Chord also;
        // The game sees the key too
        bool passthrough;
        // Still fires while typing in a text box
        bool while_typing;
        // Where the key someone picks is kept
        Setting.Scope scope;
        // Held, like a key to move with: it fires whatever modifiers are down too, and it can be a
        // modifier itself, like Shift. Its chord has no modifiers.
        bool held;
    }

    // Sticks go -1 to 1 with up and right positive, triggers 0 to 1, with no dead zone. Every controller
    // that's connected, merged into one.
    struct GamepadAxes {
        f32 left_x;
        f32 left_y;
        f32 right_x;
        f32 right_y;
        f32 left_trigger;
        f32 right_trigger;
    }
}

trait Input {
    // Held now. Losing focus lets go of everything. Any thread.
    bool keyDown(Key key);
    bool buttonDown(MouseButton button);
    // Null if it doesn't know yet. Any thread.
    ?Point mousePos();
    // A key setting listed under the plugin in Settings. Gone with the plugin.
    Keybind!KeybindError bind(Action action, keep Keybind.Fired fired);
    // Sticks and triggers, or null without a controller. Any thread.
    ?GamepadAxes gamepad();
}
