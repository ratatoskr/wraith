// Where plugin code runs. Draws are the render thread's, where UI works, and ticks the game
// thread's, where the game's own code runs. Unless a plugin drives ticks from the game's own thread,
// they're the same thread, and each tick runs just before its draw.

namespace Wraith;

error ThreadsError { NoFrames = 1, Failed }

namespace Threads {
    // Once a frame on the render thread, inside an ImGui frame. That's the overlay's, or a headless one
    // nobody sees when the overlay can't draw.
    fn void Draw();

    // Once, on the render thread at the start of the next draw, before its tick.
    fn void Task();

    // Once a tick on the game thread, where the game's own code runs. No drawing here.
    fn void Tick();

    trait Subscription {
        // No more calls. Fine to call twice, or from inside one.
        void cancel();
    }

    // Says a plugin's done winding down, from `onStopping`.
    trait WindDown {
        // Any thread. Fine to call twice.
        void done();
    }

    // As the plugin's about to stop, with everything still working.
    fn void Stopping(WindDown wind_down);

    // Ticks from the game's own thread, for games that don't run it on the render thread.
    trait TickDriver {
        // Once a game frame, on the game's thread. Runs every `onTick`. Does nothing unless it's active.
        void tick();
        // Whether its ticks are the ones that count. A game's plugin wins over a game engine's, which
        // wins over the rest, and the first to ask wins a tie. The next one takes over when it goes.
        bool active();
        // Hands ticks to the next driver, or back to the render thread. Fine to call twice.
        void release();
    }
}

trait Threads {
    // Once a frame on the render thread, for drawing UI. Gone with the plugin.
    Subscription!ThreadsError onDraw(keep Draw draw);
    // On the game thread once a tick, for game logic. That's the render thread just before each
    // draw, unless a plugin drives ticks. Gone with the plugin.
    Subscription!ThreadsError onTick(keep Tick tick);
    // Takes over ticks, for a game engine or game plugin that knows the game's own thread. Ticks
    // wait for its first `tick`, so ask in `start`. Gone with the plugin.
    TickDriver!ThreadsError driveTicks();
    // As the plugin's about to be unloaded, before anything it was given stops, so it can put back
    // what it changed in the game from the thread that can, like with `toGame`. Call `wind_down.done` once
    // it's finished, from anywhere. Wraith waits up to a second for all of them, then stops it
    // anyway. Not when the game's closing and nothing ticks any more. Gone with the plugin.
    Subscription!ThreadsError onStopping(keep Stopping stopping);
    // Whether this is the thread ticks run on. False everywhere till the first tick.
    bool onGameThread();
    // Any thread. Posted from inside a task, it waits a draw.
    void!ThreadsError post(keep Task task);
    // Milliseconds on a steady clock, with fractions. Any thread.
    f64 now();

    // Waits and hops. Awaiting any other async call carries on on the thread that made it. These
    // carry on on another, the same in every language.

    // Settles at the start of the next draw, before its tick, so a task can wait a frame. Awaiting it
    // carries on there, on the render thread, where it can draw. Any thread.
    async void!ThreadsError nextDraw();
    // Carries on at the next tick, on the game thread.
    async void!ThreadsError nextTick();
    // Carries on on the render thread, where drawing works. Right away if it's there already, or
    // at the next draw.
    async void!ThreadsError toRender();
    // Carries on on the game thread, where the game's own code runs, at its next tick. Right away
    // if it's there already. Never block there.
    async void!ThreadsError toGame();
    // Carries on on a worker, for slow or blocking work. Right away if it's on one already.
    async void!ThreadsError toWorker();
    // Carries on after `ms` milliseconds, back on the thread that asked, at its first draw or
    // tick after that for the render or game thread.
    async void!ThreadsError delay(u32 ms);
}
