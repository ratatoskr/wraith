// Where plugin code runs: draws on the render thread, ticks on the game thread. Unless a plugin
// drives ticks, they're the same thread and each tick runs just before its draw.

namespace Wraith;

error ThreadsError { NoFrames = 1, Failed }

namespace Threads {
    // Once a frame on the render thread, inside an ImGui frame (a headless one if the overlay can't draw).
    fn void Draw();

    // Once, on the render thread at the start of the next draw, before its tick.
    fn void Task();

    // Once a tick on the game thread. No drawing here.
    fn void Tick();

    trait Subscription {
        // Fine to call twice, or from inside one.
        void cancel();
    }

    // Says a plugin's done winding down, from `onStopping`.
    trait WindDown {
        // Any thread. Fine to call twice.
        void done();
    }

    // As the plugin's about to stop, with everything still working.
    fn void Stopping(WindDown wind_down);
}

trait Threads {
    // Once a frame on the render thread, for UI. Gone with the plugin.
    Subscription!ThreadsError onDraw(keep Draw draw);
    // Once a tick on the game thread, for game logic. Gone with the plugin.
    Subscription!ThreadsError onTick(keep Tick tick);
    // A lease on ticks, see `Lease`. While held, ticks run on its `runTick` and wait for the first, so
    // claim in `start`. Unheld, they're back on the render thread.
    Lease!ThreadsError claimTicks(keep ?Lease.Changed changed);
    // Once a game frame on the game's thread, from the ticks holder. Runs every `onTick`. A no-op otherwise.
    // Not `tick`, which C# would make the same name as `Tick`.
    void runTick();
    // Before unload, to undo game changes from the right thread. Call `wind_down.done` when finished;
    // Wraith waits up to a second. Not when the game's closing. Gone with the plugin.
    Subscription!ThreadsError onStopping(keep Stopping stopping);
    // Whether this is the tick thread. False everywhere till the first tick.
    bool onGameThread();
    // Any thread. Posted from inside a task, it waits a draw.
    void!ThreadsError post(keep Task task);
    // Milliseconds on a steady clock, with fractions. Any thread.
    f64 now();

    // Other async calls resume on the calling thread; these resume elsewhere.

    // At the start of the next draw, before its tick, on the render thread. Any thread.
    async void!ThreadsError nextDraw();
    // At the next tick, on the game thread.
    async void!ThreadsError nextTick();
    // On the render thread, right away if already there, else at the next draw.
    async void!ThreadsError toRender();
    // On the game thread, right away if already there, else at its next tick. Never block there.
    async void!ThreadsError toGame();
    // On a worker, for slow or blocking work. Right away if already on one.
    async void!ThreadsError toWorker();
    // After `ms` milliseconds, back on the calling thread (its next draw or tick for those threads).
    async void!ThreadsError delay(u32 ms);
}
