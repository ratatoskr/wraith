// How a plugin runs, whatever language it's in.

namespace Wraith;

error StartError { Failed = 1 }

namespace Plugin {
    // What a plugin gets as it starts.
    struct Guest {
        string name;
        // A copy of its folder, deleted once it's unloaded
        string dir;
        // Everything it can use. Stops working once it's unloaded.
        Api wraith;
        // Wraith's schemas with its own and those of plugins it depends on, as one bundle, for languages
        // that read them while running, like scripts.
        string schema;
        // What the plugins it depends on offer, one per [Service] trait in their schemas.
        []Service services;
    }

    // A plugin's [Service] trait, as its main exports it.
    struct Service {
        string plugin;
        string trait;
        object obj;
    }

    // What runs plugins of one kind, provided as `wraith.kind.<name>` at major 1. JS and Lua are built in.
    // A plugin's manifest names its kind as its provider.
    trait Kind {
        Plugin!StartError start(keep Guest guest);
    }
}

// One running plugin, from its kind's start.
trait Plugin {
    // Its owner's closed already, so nothing calls into what it gave out.
    void stop();
    // Nothing points at its code anymore.
    void unload();
    // Where its module's loaded, or 0 for things like scripts.
    usize module();
    // What its main exports for a [Service] trait in its schemas, or nothing.
    object serviceFor(string trait);
}

