// What the Timings and Signatures windows list from native code: wraith_core zones and heaps, by
// layout version. Listed till removed or the plugin goes.

namespace Wraith;

namespace Diagnostics {
    enum ScanOutcome : u8 { found, not_found, not_unique }

    struct SignatureScan {
        string name;
        string pattern;
        usize start;
        usize length;
        // Scanned the code as it was before anything patched it
        bool original;
        ScanOutcome outcome;
        usize address;
        u64 ns;
    }

    // A scan, saying which copy of the code it read
    struct ScanRecord {
        string name;
        string pattern;
        usize start;
        usize length;
        Addresses.Source source;
        // Took the first of several matches
        bool first_match;
        ScanOutcome outcome;
        usize address;
        u64 ns;
    }
}

trait Diagnostics {
    void addZone(usize zone, u32 version);
    void removeZone(usize zone);
    void addHeap(usize heap, u32 version);
    void removeHeap(usize heap);
    // For the Signatures window, and named `plugin.name` in the address list when found
    void recordScan(SignatureScan scan);
    // The unpatched copy of the game's code from `start`, or 0
    usize original(usize start, usize length);
    // Like `recordScan`, with which copy it read
    void recordScanFrom(ScanRecord scan);
    // Where `source`'s copy of the game's code from `start` is, or 0. Live has none
    usize codeCopy(usize start, usize length, Addresses.Source source);
}
