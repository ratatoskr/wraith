// Hooks on the game's code. Handlers run on the game thread that hit them, which waits. All put back
// when the plugin goes.

namespace Wraith;

error HookError {
    // Someone else hooked it already
    AlreadyHooked = 1,
    FunctionTooSmall,
    // It changed since it was looked at
    TargetModified,
    // Not what `expect` said was there
    UnexpectedBytes,
    // A signature that doesn't parse, or can't cross
    InvalidSignature,
    // A handler that isn't a fn value of the signature's type
    WrongHandler,
    // An `expect` that doesn't parse
    InvalidPattern,
    // A size that ends inside an instruction
    SplitsInstruction,
    // Not declared in the plugin's schemas, or not found in the game
    NotFound,
    Failed,
}

namespace Hook {
    struct Options {
        // For the handler to read with `context()`
        usize context;
        // Starts off rather than on
        bool disabled;
    }

    // What a native detour's `enter` gives, see `Hooks.NativeCalls`.
    struct Call {
        // The hook's object data, for its `Hook`
        usize hook;
        // The original function, to call on
        usize original;
        usize context;
        // False while it's being destroyed: just call `original`, and don't `leave`.
        bool entered;
    }
}

trait Hook {
    void!HookError enable();
    void!HookError disable();
    // Puts the code back for good, waiting for calls in flight. Fine to call twice.
    void destroy();
    // A function hook's original, or a mid hook's covered instructions, which carry on after.
    usize original();
    // Where a mid hook's code carries on, like `jmp resume`. 0 for function hooks.
    usize resume();
}

namespace Hooks {
    struct MidOptions {
        // Replaces code there, so returning carries on after it. Else it runs before the instruction.
        bool replace;
        // Bytes replaced, ending between instructions. 0 is what `expect` covers, or the one instruction.
        u32 size;
        // Bytes like `89 83 ?? ??` or asm like `cmp ecx, eax` that must be there. Empty skips the check.
        string expect;
        // Starts off rather than on
        bool disabled;
        // Before the address list's, for `expect`
        []Addresses.Name names;
    }

    // Changes to the registers go back into the thread.
    fn void MidHandler(inout Cpu cpu);

    // C functions for native detours, which bypass the plugin's owner since a hook can be hit during
    // unload. `enter` is `fn () Hook.Call`, called first; `leave` is `fn (usize hook)`, called if it entered.
    struct NativeCalls {
        usize enter;
        usize leave;
    }
}

trait Hooks {
    // Runs `handler` with the registers just before the code at `target` runs.
    Hook!HookError mid(usize target, MidOptions options, keep MidHandler handler);
    // Sends calls at `target` to `handler`, a fn value of `signature`'s type, like
    // `[Thiscall] fn i32 (usize self, f32 amount)`. Scripts make one with `salamander.fn`.
    Hook!HookError detour(usize target, string signature, keep object handler, Hook.Options options);
    // The same for the function pointer at `slot`, which gets swapped.
    Hook!HookError detourSlot(usize slot, string signature, keep object handler, Hook.Options options);
    // A function or method the plugin's schemas declare, like `Player.heal`, typed as declared. A
    // [Virtual(n)] one swaps its slot in the struct's [VirtualTable].
    Hook!HookError named(string name, keep object handler, Hook.Options options);
    // The context of the hook whose handler's running on this thread, or 0.
    usize context();
    // Sends calls at `target` to the native function at `detour`, which finds its hook through `nativeCalls`.
    Hook!HookError detourNative(usize target, usize detour, Hook.Options options);
    // The same for the function pointer at `slot`.
    Hook!HookError detourSlotNative(usize slot, usize detour, Hook.Options options);
    NativeCalls nativeHookCalls();
}
