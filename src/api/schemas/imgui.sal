    // Implied size = ImVec2(0, 0)
    static bool ColorButton(cstring desc_id, ImVec4 col, ImGuiColorEditFlags flags);
    // display a color square/button, hover for details, return true when pressed.
    static bool ColorButtonEx(cstring desc_id, ImVec4 col, ImGuiColorEditFlags flags, ImVec2 size);
    static bool TreeNode(cstring label);
    // helper variation to easily decorrelate the id from the displayed string. Read the FAQ about why and how to use ID. to align arbitrary text at the same level as a TreeNode() you can use Bullet().
    static bool TreeNodeStrUnformatted(cstring str_id, cstring text);
    static bool TreeNodeEx(cstring label, ImGuiTreeNodeFlags flags);
    static bool TreeNodeExStrUnformatted(cstring str_id, ImGuiTreeNodeFlags flags, cstring text);
    // ~ Indent()+PushID(). Already called by TreeNode() when returning true, but you can call TreePush/TreePop yourself if desired.
    static void TreePush(cstring str_id);
    // ~ Unindent()+PopID()
    static void TreePop();
    // horizontal distance preceding label when using TreeNode*() or Bullet() == (g.FontSize + style.FramePadding.x*2) for a regular unframed TreeNode
    static f32 GetTreeNodeToLabelSpacing();
    // if returning 'true' the header is open. doesn't indent nor push on ID stack. user doesn't have to call TreePop().
    static bool CollapsingHeader(cstring label, ImGuiTreeNodeFlags flags);
    // when 'p_visible != NULL': if '*p_visible==true' display an additional small close button on upper right of the header which will set the bool to false when clicked, if '*p_visible==false' don't display the header.
    static bool CollapsingHeaderBoolPtr(cstring label, inout bool p_visible, ImGuiTreeNodeFlags flags);
    // set next TreeNode/CollapsingHeader open state.
    static void SetNextItemOpen(bool is_open, ImGuiCond cond);
    // set id to use for open/close storage (default to same as item id).
    static void SetNextItemStorageID(u32 storage_id);
    // retrieve tree node open/close state.
    static bool TreeNodeGetOpen(u32 storage_id);
    // Implied selected = false, flags = 0, size = ImVec2(0, 0)
    static bool Selectable(cstring label);
    // "bool selected" carry the selection state (read-only). Selectable() is clicked is returns true so you can modify your selection state. size.x==0.0: use remaining width, size.x>0.0: specify width. size.y==0.0: use label height, size.y>0.0: specify height
    static bool SelectableEx(cstring label, bool selected, ImGuiSelectableFlags flags, ImVec2 size);
    // Implied size = ImVec2(0, 0)
    static bool SelectableBoolPtr(cstring label, inout bool p_selected, ImGuiSelectableFlags flags);
    // "bool* p_selected" point to the selection state (read-write), as a convenient helper.
    static bool SelectableBoolPtrEx(cstring label, inout bool p_selected, ImGuiSelectableFlags flags, ImVec2 size);
    // Was the last item selection state toggled? Useful if you need the per-item information _before_ reaching EndMultiSelect(). We only returns toggle _event_ in order to handle clipping correctly.
    static bool IsItemToggledSelection();
    // open a framed scrolling region
    static bool BeginListBox(cstring label, ImVec2 size);
    // only call EndListBox() if BeginListBox() returned true!
    static void EndListBox();
    // append to menu-bar of current window (requires ImGuiWindowFlags_MenuBar flag set on parent window).
    static bool BeginMenuBar();
    // only call EndMenuBar() if BeginMenuBar() returns true!
    static void EndMenuBar();
    // create and append to a full screen menu-bar.
    static bool BeginMainMenuBar();
    // only call EndMainMenuBar() if BeginMainMenuBar() returns true!
    static void EndMainMenuBar();
    // Implied enabled = true
    static bool BeginMenu(cstring label);
    // create a sub-menu entry. only call EndMenu() if this returns true!
    static bool BeginMenuEx(cstring label, bool enabled);
    // only call EndMenu() if BeginMenu() returns true!
    static void EndMenu();
    // Implied shortcut = NULL, selected = false, enabled = true
    static bool MenuItem(cstring label);
    // return true when activated.
    static bool MenuItemEx(cstring label, cstring shortcut, bool selected, bool enabled);
    // return true when activated + toggle (*p_selected) if p_selected != NULL
    static bool MenuItemBoolPtr(cstring label, cstring shortcut, inout bool p_selected, bool enabled);
    // begin/append a tooltip window.
    static bool BeginTooltip();
    // only call EndTooltip() if BeginTooltip()/BeginItemTooltip() returns true!
    static void EndTooltip();
    // set a text-only tooltip. Often used after a ImGui::IsItemHovered() check. Override any previous call to SetTooltip().
    static void SetTooltipUnformatted(cstring text);
    // begin/append a tooltip window if preceding item was hovered.
    static bool BeginItemTooltip();
    // set a text-only tooltip if preceding item was hovered. override any previous call to SetTooltip().
    static void SetItemTooltipUnformatted(cstring text);
    // return true if the popup is open, and you can start outputting to it.
    static bool BeginPopup(cstring str_id, ImGuiWindowFlags flags);
    // return true if the modal is open, and you can start outputting to it.
    static bool BeginPopupModal(cstring name, inout ?bool p_open, ImGuiWindowFlags flags);
    // only call EndPopup() if BeginPopupXXX() returns true!
    static void EndPopup();
    // call to mark popup as open (don't call every frame!).
    static bool OpenPopup(cstring str_id, ImGuiPopupFlags popup_flags);
    // id overload to facilitate calling from nested stacks
    static bool OpenPopupID(u32 id, ImGuiPopupFlags popup_flags);
    // helper to open popup when clicked on last item. Default to ImGuiPopupFlags_MouseButtonRight == 1. (note: actually triggers on the mouse _released_ event to be consistent with popup behaviors)
    static bool OpenPopupOnItemClick(cstring str_id, ImGuiPopupFlags popup_flags);
    // manually close the popup we have begin-ed into.
    static void CloseCurrentPopup();
    // Implied str_id = NULL, popup_flags = 0
    static bool BeginPopupContextItem();
    // open+begin popup when clicked on last item. Use str_id==NULL to associate the popup to previous item. If you want to use that on a non-interactive item such as Text() you need to pass in an explicit ID here. read comments in .cpp!
    static bool BeginPopupContextItemEx(cstring str_id, ImGuiPopupFlags popup_flags);
    // Implied str_id = NULL, popup_flags = 0
    static bool BeginPopupContextWindow();
    // open+begin popup when clicked on current window.
    static bool BeginPopupContextWindowEx(cstring str_id, ImGuiPopupFlags popup_flags);
    // Implied str_id = NULL, popup_flags = 0
    static bool BeginPopupContextVoid();
    // open+begin popup when clicked in void (where there are no windows).
    static bool BeginPopupContextVoidEx(cstring str_id, ImGuiPopupFlags popup_flags);
    // return true if the popup is open.
    static bool IsPopupOpen(cstring str_id, ImGuiPopupFlags flags);
    // Implied outer_size = ImVec2(0.0f, 0.0f), inner_width = 0.0f
    static bool BeginTable(cstring str_id, i32 columns, ImGuiTableFlags flags);
    static bool BeginTableEx(cstring str_id, i32 columns, ImGuiTableFlags flags, ImVec2 outer_size, f32 inner_width);
    // only call EndTable() if BeginTable() returns true!
    static void EndTable();
    // Implied row_flags = 0, min_row_height = 0.0f
    static void TableNextRow();
    // append into the first cell of a new row. 'min_row_height' include the minimum top and bottom padding aka CellPadding.y * 2.0f.
    static void TableNextRowEx(ImGuiTableRowFlags row_flags, f32 min_row_height);
    // append into the next column (or first column of next row if currently in last column). Return true when column is visible.
    static bool TableNextColumn();
    // append into the specified column. Return true when column is visible.
    static bool TableSetColumnIndex(i32 column_n);
    // Implied init_width_or_weight = 0.0f, user_data = 0
    static void TableSetupColumn(cstring label, ImGuiTableColumnFlags flags);
    static void TableSetupColumnEx(cstring label, ImGuiTableColumnFlags flags, f32 init_width_or_weight, u32 user_data);
    // lock columns/rows so they stay visible when scrolled.
    static void TableSetupScrollFreeze(i32 cols, i32 rows);
    // submit one header cell manually (rarely used)
    static void TableHeader(cstring label);
    // submit a row with headers cells based on data provided to TableSetupColumn() + submit context menu
    static void TableHeadersRow();
    // submit a row with angled headers for every column with the ImGuiTableColumnFlags_AngledHeader flag. MUST BE FIRST ROW.
    static void TableAngledHeadersRow();
    // return number of columns (value passed to BeginTable)
    static i32 TableGetColumnCount();
    // return current column index.
    static i32 TableGetColumnIndex();
    // return current row index (header rows are accounted for)
    static i32 TableGetRowIndex();
    // return "" if column didn't have a name declared by TableSetupColumn(). Pass -1 to use current column.
    static cstring TableGetColumnName(i32 column_n);
    // return column flags so you can query their Enabled/Visible/Sorted/Hovered status flags. Pass -1 to use current column.
    static ImGuiTableColumnFlags TableGetColumnFlags(i32 column_n);
    // change user accessible enabled/disabled state of a column. Set to false to hide the column. User can use the context menu to change this themselves (right-click in headers, or right-click in columns body with ImGuiTableFlags_ContextMenuInBody)
    static void TableSetColumnEnabled(i32 column_n, bool v);
    // return hovered column. return -1 when table is not hovered. return columns_count if the unused space at the right of visible columns is hovered. Can also use (TableGetColumnFlags() & ImGuiTableColumnFlags_IsHovered) instead.
    static i32 TableGetHoveredColumn();
    // change the color of a cell, row, or column. See ImGuiTableBgTarget_ flags for details.
    static void TableSetBgColor(ImGuiTableBgTarget target, u32 color, i32 column_n);
    // Implied count = 1, id = NULL, borders = true
    static void Columns();
    static void ColumnsEx(i32 count, cstring id, bool borders);
    // next column, defaults to current row or next row if the current row is finished
    static void NextColumn();
    // get current column index
    static i32 GetColumnIndex();
    // get column width (in pixels). pass -1 to use current column
    static f32 GetColumnWidth(i32 column_index);
    // set column width (in pixels). pass -1 to use current column
    static void SetColumnWidth(i32 column_index, f32 width);
    // get position of column line (in pixels, from the left side of the contents region). pass -1 to use current column, otherwise 0..GetColumnsCount() inclusive. column 0 is typically 0.0f
    static f32 GetColumnOffset(i32 column_index);
    // set position of column line (in pixels, from the left side of the contents region). pass -1 to use current column
    static void SetColumnOffset(i32 column_index, f32 offset_x);
    static i32 GetColumnsCount();
    // create and append into a TabBar
    static bool BeginTabBar(cstring str_id, ImGuiTabBarFlags flags);
    // only call EndTabBar() if BeginTabBar() returns true!
    static void EndTabBar();
    // create a Tab. Returns true if the Tab is selected.
    static bool BeginTabItem(cstring label, inout ?bool p_open, ImGuiTabItemFlags flags);
    // only call EndTabItem() if BeginTabItem() returns true!
    static void EndTabItem();
    // create a Tab behaving like a button. return true when clicked. cannot be selected in the tab bar.
    static bool TabItemButton(cstring label, ImGuiTabItemFlags flags);
    // notify TabBar or Docking system of a closed tab/window ahead (useful to reduce visual flicker on reorderable tab bars). For tab-bar: call after BeginTabBar() and before Tab submissions. Otherwise call with a window name.
    static void SetTabItemClosed(cstring tab_or_docked_window_label);
    // Implied size = ImVec2(0, 0), flags = 0, window_class = NULL
    static u32 DockSpace(u32 dockspace_id);
    // Implied dockspace_id = 0, viewport = NULL, flags = 0, window_class = NULL
    static u32 DockSpaceOverViewport();
    // set next window dock id
    static void SetNextWindowDockID(u32 dock_id, ImGuiCond cond);
    // get dock id of current window, or 0 if not associated to any docking node.
    static u32 GetWindowDockID();
    // is current window docked into another window?
    static bool IsWindowDocked();
    // start logging to tty (stdout)
    static void LogToTTY(i32 auto_open_depth);
    // start logging to file
    static void LogToFile(i32 auto_open_depth, cstring filename);
    // start logging to OS clipboard
    static void LogToClipboard(i32 auto_open_depth);
    // stop logging (close file, etc.)
    static void LogFinish();
    // helper to display buttons for logging to tty/file/clipboard
    static void LogButtons();
    // pass text data straight to log (without being displayed)
    static void LogTextUnformatted(cstring text);
    // call after submitting an item which may be dragged. when this return true, you can call SetDragDropPayload() + EndDragDropSource()
    static bool BeginDragDropSource(ImGuiDragDropFlags flags);
    // only call EndDragDropSource() if BeginDragDropSource() returns true!
    static void EndDragDropSource();
    // call after submitting an item that may receive a payload. If this returns true, you can call AcceptDragDropPayload() + EndDragDropTarget()
    static bool BeginDragDropTarget();
    // only call EndDragDropTarget() if BeginDragDropTarget() returns true!
    static void EndDragDropTarget();
    static void BeginDisabled(bool disabled);
    static void EndDisabled();
    static void PushClipRect(ImVec2 clip_rect_min, ImVec2 clip_rect_max, bool intersect_with_current_clip_rect);
    static void PopClipRect();
    // make last item the default focused item of a newly appearing window.
    static void SetItemDefaultFocus();
    // Implied offset = 0
    static void SetKeyboardFocusHere();
    // focus keyboard on the next widget. Use positive 'offset' to access sub components of a multiple component widget. Use -1 to access previous widget.
    static void SetKeyboardFocusHereEx(i32 offset);
    // alter visibility of keyboard/gamepad cursor. by default: show when using an arrow key, hide when clicking with mouse.
    static void SetNavCursorVisible(bool visible);
    // allow next item to be overlapped by a subsequent item. Typically useful with InvisibleButton(), Selectable(), TreeNode() covering an area where subsequent items may need to be added. Note that both Selectable() and TreeNode() have dedicated flags doing this.
    static void SetNextItemAllowOverlap();
    // is the last item hovered? (and usable, aka not blocked by a popup, etc.). See ImGuiHoveredFlags for more options.
    static bool IsItemHovered(ImGuiHoveredFlags flags);
    // is the last item active? (e.g. button being held, text field being edited. This will continuously return true while holding mouse button on an item. Items that don't interact will always return false)
    static bool IsItemActive();
    // is the last item focused for keyboard/gamepad navigation?
    static bool IsItemFocused();
    // Implied mouse_button = 0
    static bool IsItemClicked();
    // is the last item hovered and mouse clicked on? (**)  == IsMouseClicked(mouse_button) && IsItemHovered()Important. (**) this is NOT equivalent to the behavior of e.g. Button(). Read comments in function definition.
    static bool IsItemClickedEx(ImGuiMouseButton mouse_button);
    // is the last item visible? (items may be out of sight because of clipping/scrolling)
    static bool IsItemVisible();
    // did the last item modify its underlying value this frame? or was pressed? This is generally the same as the "bool" return value of many widgets.
    static bool IsItemEdited();
    // was the last item just made active (item was previously inactive).
    static bool IsItemActivated();
    // was the last item just made inactive (item was previously active). Useful for Undo/Redo patterns with widgets that require continuous editing.
    static bool IsItemDeactivated();
    // was the last item just made inactive and made a value change when it was active? (e.g. Slider/Drag moved). Useful for Undo/Redo patterns with widgets that require continuous editing. Note that you may get false positives (some widgets such as Combo()/ListBox()/Selectable() will return true even when clicking an already selected item).
    static bool IsItemDeactivatedAfterEdit();
    // was the last item open state toggled? set by TreeNode().
    static bool IsItemToggledOpen();
    // is any item hovered?
    static bool IsAnyItemHovered();
    // is any item active?
    static bool IsAnyItemActive();
    // is any item focused?
    static bool IsAnyItemFocused();
    // get ID of last item (~~ often same ImGui::GetID(label) beforehand)
    static u32 GetItemID();
    // get upper-left bounding rectangle of the last item (screen space)
    static ImVec2 GetItemRectMin();
    // get lower-right bounding rectangle of the last item (screen space)
    static ImVec2 GetItemRectMax();
    // get size of last item
    static ImVec2 GetItemRectSize();
    // get generic flags of last item
    static ImGuiItemFlags GetItemFlags();
    // Implied mouse_button = 0, delay = -1.0f
    static i32 GetItemClickedCountWithSingleClickDelay();
    // [BETA] building block for disambiguation between single-click and double-click. Returns 1 on single-click but delayed by io.MouseSingleClickDelay after mouse release. Returns 2+ on double-click or repeated clicks.
    static i32 GetItemClickedCountWithSingleClickDelayEx(ImGuiMouseButton mouse_button, f32 delay);
    // test if rectangle (of given size, starting from cursor position) is visible / not clipped.
    static bool IsRectVisibleBySize(ImVec2 size);
    // test if rectangle (in screen space) is visible / not clipped. to perform coarse clipping on user's side.
    static bool IsRectVisible(ImVec2 rect_min, ImVec2 rect_max);
    // get global imgui time. incremented by io.DeltaTime every frame.
    static f64 GetTime();
    // get global imgui frame count. incremented by 1 every frame.
    static i32 GetFrameCount();
    // get a string corresponding to the enum value (for display, saving, etc.).
    static cstring GetStyleColorName(ImGuiCol idx);
    // Implied text_end = NULL, hide_text_after_double_hash = false, wrap_width = -1.0f
    static ImVec2 CalcTextSize(cstring text);
    static ImVec2 CalcTextSizeEx(cstring text, cstring text_end, bool hide_text_after_double_hash, f32 wrap_width);
    static ImVec4 ColorConvertU32ToFloat4(u32 in);
    static u32 ColorConvertFloat4ToU32(ImVec4 in);
    static void ColorConvertRGBtoHSV(f32 r, f32 g, f32 b, inout f32 out_h, inout f32 out_s, inout f32 out_v);
    static void ColorConvertHSVtoRGB(f32 h, f32 s, f32 v, inout f32 out_r, inout f32 out_g, inout f32 out_b);
    // is key being held.
    static bool IsKeyDown(ImGuiKey key);
    // Implied repeat = true
    static bool IsKeyPressed(ImGuiKey key);
    // was key pressed (went from !Down to Down)? Repeat rate uses io.KeyRepeatDelay / KeyRepeatRate.
    static bool IsKeyPressedEx(ImGuiKey key, bool repeat);
    // was key released (went from Down to !Down)?
    static bool IsKeyReleased(ImGuiKey key);
    // was key chord (mods + key) pressed, e.g. you can pass 'ImGuiMod_Ctrl | ImGuiKey_S' as a key-chord. This doesn't do any routing or focus check, please consider using Shortcut() function instead.
    static bool IsKeyChordPressed(i32 key_chord);
    // uses provided repeat rate/delay. return a count, most often 0 or 1 but might be >1 if RepeatRate is small enough that DeltaTime > RepeatRate
    static i32 GetKeyPressedAmount(ImGuiKey key, f32 repeat_delay, f32 rate);
    // [DEBUG] returns English name of the key. Those names are provided for debugging purpose and are not meant to be saved persistently nor compared.
    static cstring GetKeyName(ImGuiKey key);
    // Override io.WantCaptureKeyboard flag next frame (said flag is left for your application to handle, typically when true it instructs your app to ignore inputs). e.g. force capture keyboard when your widget is being hovered. This is equivalent to setting "io.WantCaptureKeyboard = want_capture_keyboard"; after the next NewFrame() call.
    static void SetNextFrameWantCaptureKeyboard(bool want_capture_keyboard);
    static bool Shortcut(i32 key_chord, ImGuiInputFlags flags);
    static void SetNextItemShortcut(i32 key_chord, ImGuiInputFlags flags);
    // Set key owner to last item ID if it is hovered or active. Return true when ownership has been set. Roughly equivalent to 'if (TestKeyOwner(key, GetItemID()) && (IsItemHovered() || IsItemActive())) { SetKeyOwner(key, GetItemID());'.
    static bool SetItemKeyOwner(ImGuiKey key);
    // is mouse button held?
    static bool IsMouseDown(ImGuiMouseButton button);
    // Implied repeat = false
    static bool IsMouseClicked(ImGuiMouseButton button);
    // did mouse button clicked? (went from !Down to Down). Same as GetMouseClickedCount() == 1.
    static bool IsMouseClickedEx(ImGuiMouseButton button, bool repeat);
    // did mouse button released? (went from Down to !Down)
    static bool IsMouseReleased(ImGuiMouseButton button);
    // did mouse button double-clicked? Same as GetMouseClickedCount() == 2. (note that a double-click will also report IsMouseClicked() == true)
    static bool IsMouseDoubleClicked(ImGuiMouseButton button);
    // Implied delay = -1.f
    static bool IsMouseReleasedWithDelay(ImGuiMouseButton button);
    // delayed mouse release. Use sparingly. Prefer higher-level helper GetItemClickedCountWithSingleClickDelay(). Generally used with 'delay >= io.MouseDoubleClickTime' + combined with a 'io.MouseClickedLastCount==1' test.
    static bool IsMouseReleasedWithDelayEx(ImGuiMouseButton button, f32 delay);
    // return the number of successive mouse-clicks at the time where a click happen (otherwise 0).
    static i32 GetMouseClickedCount(ImGuiMouseButton button);
    // Implied clip = true
    static bool IsMouseHoveringRect(ImVec2 r_min, ImVec2 r_max);
    // is mouse hovering given bounding rect (in screen space). clipped by current clipping settings, but disregarding of other consideration of focus/window ordering/popup-block.
    static bool IsMouseHoveringRectEx(ImVec2 r_min, ImVec2 r_max, bool clip);
    // [WILL OBSOLETE] is any mouse button held? This was designed for backends, but prefer having backend maintain a mask of held mouse buttons, because upcoming input queue system will make this invalid.
    static bool IsAnyMouseDown();
    // shortcut to ImGui::GetIO().MousePos provided by user, to be consistent with other calls
    static ImVec2 GetMousePos();
    // retrieve mouse position at the time of opening popup we have BeginPopup() into (helper to avoid user backing that value themselves)
    static ImVec2 GetMousePosOnOpeningCurrentPopup();
    // is mouse dragging? (uses io.MouseDraggingThreshold if lock_threshold < 0.0f)
    static bool IsMouseDragging(ImGuiMouseButton button, f32 lock_threshold);
    // return the delta from the initial clicking position while the mouse button is pressed or was just released. This is locked and return 0.0f until the mouse moves past a distance threshold at least once (uses io.MouseDraggingThreshold if lock_threshold < 0.0f)
    static ImVec2 GetMouseDragDelta(ImGuiMouseButton button, f32 lock_threshold);
    // Implied button = 0
    static void ResetMouseDragDelta();
    //
    static void ResetMouseDragDeltaEx(ImGuiMouseButton button);
    // get desired mouse cursor shape. Important: reset in ImGui::NewFrame(), this is updated during the frame. valid before Render(). If you use software rendering by setting io.MouseDrawCursor ImGui will render those for you
    static ImGuiMouseCursor GetMouseCursor();
    // set desired mouse cursor shape
    static void SetMouseCursor(ImGuiMouseCursor cursor_type);
    // Override io.WantCaptureMouse flag next frame (said flag is left for your application to handle, typical when true it instructs your app to ignore inputs). This is equivalent to setting "io.WantCaptureMouse = want_capture_mouse;" after the next NewFrame() call.
    static void SetNextFrameWantCaptureMouse(bool want_capture_mouse);
    static cstring GetClipboardText();
    static void SetClipboardText(cstring text);
    static void DebugTextEncoding(cstring text);
    static void DebugFlashStyleColor(ImGuiCol idx);
    static void DebugStartItemPicker();
    // Call via IMGUI_DEBUG_LOG() for maximum stripping in caller code!
    static void DebugLogUnformatted(cstring text);
    // set current options for if you want to select a default format, picker type, etc. User will be able to change those settings, unless you pass the _NoOptions flag to your calls.
    static void SetColorEditOptions(ImGuiColorEditFlags flags);
    // Set font scale factor for current window. Prefer using PushFont(NULL, style.FontSizeBase * factor) or use style.FontScaleMain to scale all windows.
    static void SetWindowFontScale(f32 scale);
    // <-- 'border_col' was removed in favor of ImGuiCol_ImageBorder. If you use 'tint_col', use ImageWithBg() instead.
    static void ImageImVec4(TextureRef tex_ref, ImVec2 image_size, ImVec2 uv0, ImVec2 uv1, ImVec4 tint_col, ImVec4 border_col);
    static void PushButtonRepeat(bool repeat);
    static void PopButtonRepeat();
    static void PushTabStop(bool tab_stop);
    static void PopTabStop();
    // Content boundaries max (e.g. window boundaries including scrolling, or current column boundaries). You should never need this. Always use GetCursorScreenPos() and GetContentRegionAvail()!
    static ImVec2 GetContentRegionMax();
    // Content boundaries min for the window (roughly (0,0)-Scroll), in window-local coordinates. You should never need this. Always use GetCursorScreenPos() and GetContentRegionAvail()!
    static ImVec2 GetWindowContentRegionMin();
    // Content boundaries max for the window (roughly (0,0)+Size-Scroll), in window-local coordinates. You should never need this. Always use GetCursorScreenPos() and GetContentRegionAvail()!
    static ImVec2 GetWindowContentRegionMax();
}

// Where ImGui draws shapes and text, from the Ui area. Each function's dcimgui's without
// `ImDrawList_`, so `ImDrawList::AddLine` is `AddLine`.
trait ImDrawList {
    // Render-level scissoring. This is passed down to your render function but not used for CPU-side coarse clipping. Prefer using higher-level ImGui::PushClipRect() to affect logic (hit-testing and widget culling)
    void PushClipRect(ImVec2 clip_rect_min, ImVec2 clip_rect_max, bool intersect_with_current_clip_rect);
    void PushClipRectFullScreen();
    void PopClipRect();
    void PushTexture(TextureRef tex_ref);
    void PopTexture();
    // [BETA] Please notify me if you are using this.
    void PushDrawFlag(ImDrawFlags flags, bool enabled);
    void PopDrawFlag();
    ImVec2 GetClipRectMin();
    ImVec2 GetClipRectMax();
    // Implied thickness = 1.0f, flags = 0
    void AddLine(ImVec2 p1, ImVec2 p2, u32 col);
    void AddLineEx(ImVec2 p1, ImVec2 p2, u32 col, f32 thickness, ImDrawFlags flags);
    // Implied thickness = 1.0f, flags = 0
    void AddLineH(f32 min_x, f32 max_x, f32 y, u32 col);
    void AddLineHEx(f32 min_x, f32 max_x, f32 y, u32 col, f32 thickness, ImDrawFlags flags);
    // Implied thickness = 1.0f, flags = 0
    void AddLineV(f32 x, f32 min_y, f32 max_y, u32 col);
    void AddLineVEx(f32 x, f32 min_y, f32 max_y, u32 col, f32 thickness, ImDrawFlags flags);
    // Implied rounding = 0.0f, thickness = 1.0f, flags = 0
    void AddRect(ImVec2 p_min, ImVec2 p_max, u32 col);
    // a: upper-left, b: lower-right (== upper-left + size)
    void AddRectEx(ImVec2 p_min, ImVec2 p_max, u32 col, f32 rounding, f32 thickness, ImDrawFlags flags);
    // Implied rounding = 0.0f, flags = 0
    void AddRectFilled(ImVec2 p_min, ImVec2 p_max, u32 col);
    // a: upper-left, b: lower-right (== upper-left + size)
    void AddRectFilledEx(ImVec2 p_min, ImVec2 p_max, u32 col, f32 rounding, ImDrawFlags flags);
    void AddRectFilledMultiColor(ImVec2 p_min, ImVec2 p_max, u32 col_upr_left, u32 col_upr_right, u32 col_bot_right, u32 col_bot_left);
    // Implied thickness = 1.0f, flags = 0
    void AddQuad(ImVec2 p1, ImVec2 p2, ImVec2 p3, ImVec2 p4, u32 col);
    void AddQuadEx(ImVec2 p1, ImVec2 p2, ImVec2 p3, ImVec2 p4, u32 col, f32 thickness, ImDrawFlags flags);
    void AddQuadFilled(ImVec2 p1, ImVec2 p2, ImVec2 p3, ImVec2 p4, u32 col);
    // Implied thickness = 1.0f, flags = 0
    void AddTriangle(ImVec2 p1, ImVec2 p2, ImVec2 p3, u32 col);
    void AddTriangleEx(ImVec2 p1, ImVec2 p2, ImVec2 p3, u32 col, f32 thickness, ImDrawFlags flags);
    void AddTriangleFilled(ImVec2 p1, ImVec2 p2, ImVec2 p3, u32 col);
    // Implied num_segments = 0, thickness = 1.0f, flags = 0
    void AddCircle(ImVec2 center, f32 radius, u32 col);
    void AddCircleEx(ImVec2 center, f32 radius, u32 col, i32 num_segments, f32 thickness, ImDrawFlags flags);
    void AddCircleFilled(ImVec2 center, f32 radius, u32 col, i32 num_segments);
    // Implied thickness = 1.0f, flags = 0
    void AddNgon(ImVec2 center, f32 radius, u32 col, i32 num_segments);
    void AddNgonEx(ImVec2 center, f32 radius, u32 col, i32 num_segments, f32 thickness, ImDrawFlags flags);
    void AddNgonFilled(ImVec2 center, f32 radius, u32 col, i32 num_segments);
    // Implied rot = 0.0f, num_segments = 0, thickness = 1.0f, flags = 0
    void AddEllipse(ImVec2 center, ImVec2 radius, u32 col);
    void AddEllipseEx(ImVec2 center, ImVec2 radius, u32 col, f32 rot, i32 num_segments, f32 thickness, ImDrawFlags flags);
    // Implied rot = 0.0f, num_segments = 0
    void AddEllipseFilled(ImVec2 center, ImVec2 radius, u32 col);
    void AddEllipseFilledEx(ImVec2 center, ImVec2 radius, u32 col, f32 rot, i32 num_segments);
    // Implied text_end = NULL
    void AddText(ImVec2 pos, u32 col, cstring text_begin);
    void AddTextEx(ImVec2 pos, u32 col, cstring text_begin, cstring text_end);
    // Cubic Bezier (4 control points)
    void AddBezierCubic(ImVec2 p1, ImVec2 p2, ImVec2 p3, ImVec2 p4, u32 col, f32 thickness, i32 num_segments, ImDrawFlags flags);
    // Quadratic Bezier (3 control points)
    void AddBezierQuadratic(ImVec2 p1, ImVec2 p2, ImVec2 p3, u32 col, f32 thickness, i32 num_segments, ImDrawFlags flags);
    // Implied uv_min = ImVec2(0, 0), uv_max = ImVec2(1, 1), col = IM_COL32_WHITE
    void AddImage(TextureRef tex_ref, ImVec2 p_min, ImVec2 p_max);
    void AddImageEx(TextureRef tex_ref, ImVec2 p_min, ImVec2 p_max, ImVec2 uv_min, ImVec2 uv_max, u32 col);
    // Implied uv1 = ImVec2(0, 0), uv2 = ImVec2(1, 0), uv3 = ImVec2(1, 1), uv4 = ImVec2(0, 1), col = IM_COL32_WHITE
    void AddImageQuad(TextureRef tex_ref, ImVec2 p1, ImVec2 p2, ImVec2 p3, ImVec2 p4);
    void AddImageQuadEx(TextureRef tex_ref, ImVec2 p1, ImVec2 p2, ImVec2 p3, ImVec2 p4, ImVec2 uv1, ImVec2 uv2, ImVec2 uv3, ImVec2 uv4, u32 col);
    void AddImageRounded(TextureRef tex_ref, ImVec2 p_min, ImVec2 p_max, ImVec2 uv_min, ImVec2 uv_max, u32 col, f32 rounding, ImDrawFlags flags);
    void PathClear();
    void PathLineTo(ImVec2 pos);
    void PathLineToMergeDuplicate(ImVec2 pos);
    void PathFillConvex(u32 col, ImDrawFlags flags);
    void PathFillConcave(u32 col);
    void PathStroke(u32 col, f32 thickness, ImDrawFlags flags);
    void PathArcTo(ImVec2 center, f32 radius, f32 a_min, f32 a_max, i32 num_segments);
    // Use precomputed angles for a 12 steps circle
    void PathArcToFast(ImVec2 center, f32 radius, i32 a_min_of_12, i32 a_max_of_12);
    // Implied num_segments = 0
    void PathEllipticalArcTo(ImVec2 center, ImVec2 radius, f32 rot, f32 a_min, f32 a_max);
    // Ellipse
    void PathEllipticalArcToEx(ImVec2 center, ImVec2 radius, f32 rot, f32 a_min, f32 a_max, i32 num_segments);
    // Cubic Bezier (4 control points)
    void PathBezierCubicCurveTo(ImVec2 p2, ImVec2 p3, ImVec2 p4, i32 num_segments);
    // Quadratic Bezier (3 control points)
    void PathBezierQuadraticCurveTo(ImVec2 p2, ImVec2 p3, i32 num_segments);
    void PathRect(ImVec2 rect_min, ImVec2 rect_max, f32 rounding, ImDrawFlags flags);
    // This is useful if you need to forcefully create a new draw call (to allow for dependent rendering / blending). Otherwise primitives are merged into the same draw-call as much as possible
    void AddDrawCmd();
    void ChannelsSplit(i32 count);
    void ChannelsMerge();
    void ChannelsSetCurrent(i32 n);
    void PrimReserve(i32 idx_count, i32 vtx_count);
    void PrimUnreserve(i32 idx_count, i32 vtx_count);
    // Axis aligned rectangle (composed of two triangles)
    void PrimRect(ImVec2 a, ImVec2 b, u32 col);
    void PrimRectUV(ImVec2 a, ImVec2 b, ImVec2 uv_a, ImVec2 uv_b, u32 col);
    void PrimQuadUV(ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 d, ImVec2 uv_a, ImVec2 uv_b, ImVec2 uv_c, ImVec2 uv_d, u32 col);
    void PrimWriteVtx(ImVec2 pos, ImVec2 uv, u32 col);
    void PrimWriteIdx(u16 idx);
    // Write vertex with unique index
    void PrimVtx(ImVec2 pos, ImVec2 uv, u32 col);
    // OBSOLETED in 1.92.8: NEW FUNCTION SIGNATURE HAS 'thickness' AND 'flags' SWAPPED.
    void AddRectImDrawFlags(ImVec2 p_min, ImVec2 p_max, u32 col, f32 rounding, ImDrawFlags flags, f32 thickness);
    // OBSOLETED in 1.92.8: NEW FUNCTION SIGNATURE HAS 'thickness' AND 'flags' SWAPPED.
    void PathStrokeImDrawFlags(u32 col, ImDrawFlags flags, f32 thickness);
    // RENAMED in 1.92.0
    void PushTextureID(TextureRef tex_ref);
    // RENAMED in 1.92.0
    void PopTextureID();
}
