// Code and globals the plugin's schemas declare, by name like `Player.heal`. Methods come from a
// struct or its bases.

namespace Wraith;

error SchemaError {
    // Nothing by that name in the plugin's schemas
    Unknown = 1,
    // Declared, but not found, like a signature that didn't match once
    NotFound,
    // A [Virtual(n)] method of a struct with no [VirtualTable], so it needs an object
    NeedsObject,
    // A schema that doesn't parse
    Invalid,
    Failed,
}

trait Schema {
    // Where a function, method or static is, found once then kept. A struct's name gives its [VirtualTable].
    usize!SchemaError address(string name);
    // Where `object` has a method, through its own vtable for [Virtual(n)] ones.
    usize!SchemaError method(usize object, string name);
    // Adds or replaces the plugin's schema file `name`.
    void!SchemaError add(string name, string text);
}
