// Virtual files, and watching the game's file I/O. Paths use forward slashes going out; either works
// going in. Any thread.

namespace Wraith;

error VfsError {
    // The game's file I/O isn't being watched, like when it's off in Settings
    Unavailable = 1,
    // Not a full path, or too long
    InvalidPath,
    // A folder where a file should be, or the other way around
    WrongKind,
    NotFound,
    Failed,
}

namespace Vfs {
    enum EventKind : u8 {
        // Before an open. The reply can redirect or refuse it.
        open,
        opened,
        // An open that failed, with its status
        failed,
        // After a read. The reply can replace what it read.
        read,
        // Before a write. The reply can refuse it.
        write,
        // The last handle to a file closed
        closed,
    }

    bitfield Kinds : u8 { bool open; bool opened; bool failed; bool read; bool write; bool closed; }

    enum Denial : u8 { none, access_denied, not_found, sharing_violation, write_protected }

    struct WatchOptions {
        Kinds kinds;
        // Like `C:/Game/data/*.pak`. `*` matches anything, slashes too, `?` one character. Case-insensitive. Empty is all.
        string pattern;
        // Also while the loader opens a DLL. It holds a lock then, so don't wait on other threads.
        bool loader;
        // Also existence checks like `GetFileAttributes`, as opens with `query` set
        bool queries;
    }

    struct Event {
        EventKind kind;
        // For `open`, where it'll be opened after any earlier redirect.
        string path;
        // What the game asked for. Differs from `path` only when redirected.
        string requested;
        // The same for every handle to one open file. 0 for `open` and `failed`.
        u64 file;
        bool read_access;
        bool write_access;
        bool virtual;
        bool directory;
        // An existence check, with no handle coming of it
        bool query;
        u32 thread;
        // Where a read or write starts. -1 for the current position.
        i64 offset;
        // What a read got or a write writes
        []u8 data;
        // The NTSTATUS for `failed`
        u32 status;
    }

    // Left zero, it goes ahead.
    struct Reply {
        // For `open` and `write`
        Denial deny;
        // For `open`, where to open instead, which can be a virtual file
        string redirect;
        // For `read`, bytes to put over what it read, as many as fit
        bool replace;
        []u8 data;
    }

    // On the thread doing the I/O, which waits for it.
    fn Reply Handler(Event event);

    trait Watch {
        // Waits for the handler if it's running, unless called from inside it. Fine to call twice.
        void cancel();
    }
}

trait Vfs {
    // Serves `bytes` at `path`, hiding any real file, until removed or the plugin goes.
    void!VfsError put(string path, []u8 bytes);
    // A virtual folder, so files the game makes in it are virtual too.
    void!VfsError putDir(string path);
    // A virtual file or folder and its contents, whoever put it. False if there wasn't one.
    bool remove(string path);
    // A copy of a virtual file's bytes, which the caller owns.
    blob!VfsError read(string path);
    // Until it's cancelled or the plugin goes.
    Watch!VfsError addWatch(WatchOptions options, keep Handler handler);
}
