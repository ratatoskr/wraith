// The game's address list, by id like `player.health`. A plugin's own go under its name. Any thread.

namespace Wraith;

error AddressError {
    NotFound = 1,
    Unreadable,
    // Location text that doesn't parse
    InvalidAddress,
    // Empty, or has spaces
    InvalidId,
    AlreadyAdded,
    Failed,
}

namespace Addresses {
    // A name for an address, like a tweak's `@data`, for location text and asm.
    struct Name {
        string name;
        usize address;
    }

    // Which copy of the game's code an address came from: `snapshot` is taken at startup, `disk` is the exe.
    enum Source : u8 { live, snapshot, disk }

    // Which copies lookups may use, tried live, then snapshot, then disk.
    struct Sources {
        bool live;
        bool snapshot;
        bool disk;
    }

    // An address and which copy of the code it came from.
    struct Found {
        usize address;
        Source source;
    }

    struct Entry {
        // Unique for the plugin
        string id;
        // Location text, like `game.exe+0x1234` or `sig("48 8B ??", Rip)`
        string address;
        // Pointers to follow, each one's offset added after
        []i64 offsets;
        string name;
        // What's there, like `u32` or a schema type's name
        string type;
        // Bytes, so addresses inside it are named after it. 0 is just the one.
        u32 size;
    }
}

trait Addresses {
    // Where the entry with this id is now.
    usize!AddressError get(string id);
    // Where location text is now. `names` come before the list's.
    usize!AddressError resolve(string text, []Name names);
    // Until it's removed or the plugin goes. Not saved.
    void!AddressError add(Entry entry);
    // Only the plugin's own.
    void remove(string id);
    // Like `resolve`, saying which copy it was found in. Non-live means the code's hooked now.
    Found!AddressError find(string text, []Name names);
    // Which copies this plugin's lookups may use. Defaults to Wraith's setting; a sig's `Sources(..)` wins.
    void setSources(Sources sources);
    // What this plugin's lookups may use now.
    Sources activeSources();
}
