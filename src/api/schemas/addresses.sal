// The game's address list. Entries are found by id, like `player.health`. A plugin's own are listed
// under its name, like `kai.health`. Errors say what's wrong. Any thread.

error AddressError {
    NotFound = 1,
    Unreadable,
    // Location text that doesn't parse
    InvalidAddress,
    // Empty, or has spaces
    InvalidId,
    AlreadyAdded,
    Failed,
}

// A name for an address, like a tweak's `@data`, that location text and asm can use.
struct Name {
    string name;
    usize address;
}

// Which copy of the game's code an address was worked out from. `snapshot` is copied as Wraith
// starts, `disk` is the game's exe file, for code that something hooked before then
enum AddressSource : u8 { live, snapshot, disk }

// Which copies lookups may use, tried live first, then the snapshot, then disk
struct AddressSources {
    bool live;
    bool snapshot;
    bool disk;
}

// Where something is, and which copy of the code it was worked out from
struct Found {
    usize address;
    AddressSource source;
}

struct AddressEntry {
    // Unique for the plugin
    string id;
    // Location text, like `0x7FF6A0001000`, `game.exe+0x1234` or `sig("48 8B ??", Rip)`
    string address;
    // Pointers to follow from there, each one's offset added after
    []i64 offsets;
    string name;
    // What's there, like `u32` or a schema type's name
    string type;
    // Bytes, so addresses inside it are named after it. 0 is just the one.
    u32 size;
}

trait Addresses {
    // Where the entry with this id is now.
    usize!AddressError get(string id);
    // Where location text is now. `names` come before the list's.
    usize!AddressError resolve(string text, []Name names);
    // Until it's removed or the plugin goes. Not saved.
    void!AddressError add(AddressEntry entry);
    // Only the plugin's own, by the id it added.
    void remove(string id);
    // Like `resolve`, saying which copy of the code it was found in. Something hooked code found in
    // the snapshot or on disk, so its bytes are different now.
    Found!AddressError find(string text, []Name names);
    // Which copies this plugin's lookups may use: sigs in its schemas, `resolve` and `find`. Till
    // it's called, Wraith's setting says. A sig's own `Sources(..)` wins over both.
    void setSources(AddressSources sources);
    // What this plugin's lookups may use now.
    AddressSources sources();
}
