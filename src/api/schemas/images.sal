// Images to draw with ImGui. Gone with the plugin.

namespace Wraith;

error ImageError {
    // Not an image it can read, or pixels that don't match the size
    InvalidImage = 1,
    // Wider or taller than 16384
    TooBig,
    Failed,
    // No file there, for `load`
    NotFound,
}

// ImGui's `ImTextureRef`. A 0 `data` can't be drawn.
struct TextureRef { usize data; u64 id; }

namespace Image {
    struct Size { u32 width; u32 height; }
}

trait Image {
    // Zero once it's destroyed. Any thread.
    Size dimensions();
    // For the current ImGui frame only. Render thread.
    TextureRef texture();
    // Its GPU copies go over the next frames. Fine to call twice.
    void destroy();
}

trait Images {
    // Packed RGBA pixels, copied. Any thread.
    Image!ImageError create(u32 width, u32 height, []u8 rgba);
    // A PNG, JPEG, BMP, TGA or GIF's first frame. Slow, so not on the render thread.
    Image!ImageError decode([]u8 bytes);
    // A file, decoded on a worker. Relative paths are in the plugin's folder. Any thread.
    async Image!ImageError load(string path);
    // Draws it in the current window, in a draw callback. Zero size is its own size.
    void draw(Image image, ImVec2 size);
}
