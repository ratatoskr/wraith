// Everything a plugin can use, an area each. Each plugin gets its own, which stops once it's unloaded.
trait Wraith {
    Addresses addresses();
    Clipboard clipboard();
    Code code();
    Config config();
    // What Wraith's Timings and Signatures windows list, for native code
    Diagnostics diagnostics();
    Frame frame();
    // Which game this is, its files and what it's made with
    Game game();
    Schema schema();
    Hooks hooks();
    // Dear ImGui, for drawing in a frame callback
    ImGui imgui();
    Images images();
    Input input();
    Libraries libraries();
    Log log();
    // The game's C# runtime, Mono or IL2CPP, for Unity games and others
    Managed managed();
    Memory memory();
    Settings settings();
    Sound sound();
    // Locks to share between plugins, threads and tasks
    Sync sync();
    Tweaks tweaks();
    // The overlay: draw lists, toasts, the cursor and the game's input
    Ui ui();
    Vfs vfs();
    Watches watches();
}
