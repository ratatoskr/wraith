// Everything a plugin can use, an area each. Each plugin gets its own, which stops once it's unloaded.

namespace Wraith;

[Root] trait Api {
    Addresses addresses();
    // The free camera, fed the game's camera by game and engine plugins
    FreeCamera camera();
    Clipboard clipboard();
    Code code();
    Config config();
    // The Timings and Signatures windows, for native code
    Diagnostics diagnostics();
    // The game's view, captures and frame times
    Display display();
    // Which game this is, its files and engine
    Game game();
    Schema schema();
    Hooks hooks();
    // Dear ImGui, for drawing in a draw callback
    ImGui imgui();
    Images images();
    Input input();
    // Who holds the single-owner parts of the game, see `Lease`
    Leases leases();
    Libraries libraries();
    // Pickable lists of the plugin's things
    Lists lists();
    Log log();
    // The game's C# runtime
    Managed managed();
    Memory memory();
    // Posing characters, fed skeletons by game and engine plugins
    Posing posing();
    Settings settings();
    Sound sound();
    // Locks shared between plugins, threads and tasks
    Sync sync();
    // Per-frame draws and ticks, and hopping between threads
    Threads threads();
    Tweaks tweaks();
    // The overlay: draw lists, toasts, the cursor and game input
    Ui ui();
    Vfs vfs();
    Watches watches();
}
