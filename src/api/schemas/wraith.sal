// Everything a plugin can use, an area each. Each plugin gets its own, which stops once it's unloaded.

namespace Wraith;

[Root] trait Api {
    Addresses addresses();
    // The free camera, for game and engine plugins to hand it the game's camera
    FreeCamera camera();
    Clipboard clipboard();
    Code code();
    Config config();
    // What Wraith's Timings and Signatures windows list, for native code
    Diagnostics diagnostics();
    Frame frame();
    // Which game this is, its files and what it's made with
    Game game();
    Schema schema();
    Hooks hooks();
    // Dear ImGui, for drawing in a frame callback
    ImGui imgui();
    Images images();
    Input input();
    Libraries libraries();
    // Lists of the plugin's things that Wraith shows, for the player to pick from
    Lists lists();
    Log log();
    // The game's C# runtime, Mono or IL2CPP, for Unity games and others
    Managed managed();
    Memory memory();
    // Posing characters, for game and engine plugins to hand it their skeletons
    Posing posing();
    Settings settings();
    Sound sound();
    // Locks to share between plugins, threads and tasks
    Sync sync();
    Tweaks tweaks();
    // The overlay: draw lists, toasts, the cursor and the game's input
    Ui ui();
    Vfs vfs();
    Watches watches();
}
