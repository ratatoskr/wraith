// The game Wraith's in: which one, its files, and its engine. Kinds are names like `steam` or
// `unity`. Any thread.

namespace Wraith;

error GameError {
    Failed = 1,
    // A plugin has speed control off, see `setSpeedControl`
    SpeedOff,
}

namespace Game {
    struct AntiCheat {
        // Like `easy_anti_cheat`
        string id;
        // Like `Easy Anti-Cheat`
        string name;
    }

    struct Info {
        // Like `steam-1245620`, or Wraith's own name for games it knows, like `ffxiv`. `unknown` if the exe wasn't found.
        string id;
        // `steam`, `gog`, `epic`, `xbox`, `itch`, or `local`
        string store;
        // The store's name for it, or empty
        string title;
        // The store's build, like `steam:18234455`, as a manifest's `builds` lists them. Empty if unknown; only Steam so far.
        string build;
        // The exe's full path
        string exe;
        string dir;
        // From the exe's version resource, like `1.2.0.0`. Often empty.
        string file_version;
        string product_version;
        // Like `unity`, `unreal`, `godot` or `rpg_maker`, from the files beside the exe. Empty if unknown.
        string game_engine;
        // Like `IL2CPP` or `Mono` for Unity, or `MV` for RPG Maker. Can be empty.
        string game_engine_variant;
        // Like `2021.3.16`. Can be empty.
        string game_engine_version;
        // Found beside the game or loaded in it. Wraith doesn't stop for it.
        []AntiCheat anticheat;
        // Like `d3d11` or `vulkan`. Empty till the first frame.
        string graphics_api;
        // The game's HWND on Windows. 0 till it's found.
        usize window;
        // Like `0.4.0`
        string wraith_version;
    }

    // Sets the game's speed the plugin's own way, like an engine time scale. False falls back to
    // hooking the clocks. Any thread; keep it quick and don't set the speed from it.
    fn bool SpeedHandler(f64 speed);
}

trait Game {
    // Cheap. Fixed once taken, apart from the graphics API and window early on.
    Info gameInfo();
    // The exe's SHA-512 in hex, as a manifest's `hashes` lists it. Worked out in the background at startup.
    async string!GameError sha512();
    // 1 is normal, 2 twice as fast.
    f64 speed();
    // Up to 100. Goes through the speed lease holder, else hooks the game's clocks (down to 0.01).
    // 0 pauses, with a holder. Back to 1 when the setting plugin goes. Some games don't follow it.
    void!GameError setSpeed(f64 speed);
    // A lease on the game's speed, see `Lease`. While held, `handler` gets the speed, straight away
    // with the current one, and 1 when it's lost or released.
    Lease!GameError claimSpeed(keep SpeedHandler handler, keep ?Lease.Changed changed);
    // Whether the speed can be changed at all. On by default; turning it off resets the speed. A game
    // plugin's say beats an engine's, which beats the rest, then the newest, till that plugin goes.
    void setSpeedControl(bool on);
    bool speedControl();
}
