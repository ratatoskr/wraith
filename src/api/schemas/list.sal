// Lists of a plugin's things, like the game's cameras, that Wraith shows for the player to pick from.
// The plugin supplies items; Wraith keeps the picks and sends button presses back. Any thread.

namespace Wraith;

error ListError { InvalidId = 1, AlreadyOpen, Failed }

namespace ItemList {
    struct Item {
        // Stable while it's around, like its address. Not 0
        u64 id;
        // Picks are kept by name too, so they carry over when the id changes
        string name;
        // Shown on hover. Can be empty
        string detail;
        // The one in use now, like the camera on screen
        bool current;
    }

    // How many the player can pick.
    enum Pick : u8 { none, one, many }

    struct Options {
        // Defaults to the id
        string title;
        Pick pick;
        // While nothing picked is listed, the current one counts as picked, else the first
        bool current_by_default;
        // Keeps picks for next time the game starts
        bool remember;
        // Beside the current one, like "On screen". Defaults to "Current"
        string current_label;
    }

    // The player pressed add. List the new one, and `select` it if it should be picked. Render thread.
    fn void Add();
    // The player pressed remove on `id`. Render thread.
    fn void Remove(u64 id);
    // The player renamed `id`. List it again with its new name. Render thread.
    fn void Rename(u64 id, string name);
}

trait ItemList {
    // Everything in it, whenever that changes. The first is the primary.
    void set([]Item items);
    // What's picked of what's listed, in pick order, or the default. Good till the thread's next call into Wraith.
    []u64 selected();
    // Picks `id` as the player would. With `one` it replaces the pick, and 0 picks nothing.
    void select(u64 id);
    void deselect(u64 id);
    // Draws it in a window of the plugin's own. Render thread, inside a frame callback.
    void draw();
    // Gone from Wraith; picks are still kept. Fine to call twice.
    void close();
}

trait Lists {
    // `id` is unique for the plugin: letters, digits, `_`, `-` and `.`. Each callback passed adds its
    // button. Gone with the plugin.
    ItemList!ListError open(string id, ItemList.Options options, keep ?ItemList.Add add, keep ?ItemList.Remove remove, keep ?ItemList.Rename rename);
}
