// The game's C# runtime: Mono, IL2CPP or CoreCLR. Classes go by C# name, like `Game.Player` or
// `Game.Player/Stats` for nested ones. Address text takes `Class:Method+0x3a` too.
//
// Any thread, but calls queue on Wraith's one runtime thread, so look things up once. Classes, fields
// and methods don't move. Returned text and slices are good till the thread's next call into Wraith.
//
// Objects are addresses. CoreCLR's GC moves them, so `hold` ones you keep and use `heldAt` before each use.

namespace Wraith;

error ManagedError {
    // The game has none, or hasn't started it yet
    NotRunning = 1,
    NotFound,
    // Not an object or a string
    Unreadable,
    Failed,
    // `invoke`'s method threw, and the message says what
    Threw,
}

namespace Managed {
    enum Kind : u8 { none, mono, il2cpp, coreclr }

    // Which of `Value`'s fields it is.
    enum ValueKind : u8 { none, flag, integer, number, text, object }

    // An `invoke` argument or result. Integers cover whole numbers and enums, numbers floats, text
    // strings, and objects the rest by address, structs and `ref` parameters included.
    struct Value {
        ValueKind kind;
        bool flag;
        i64 integer;
        f64 number;
        string text;
        usize object;
    }

    struct Class {
        // Like `Game.Player`, or `Game.Player/Stats` nested
        string full_name;
        // Like `Player`
        string name;
        // Like `Assembly-CSharp.dll`
        string image;
        // Its parent's full name, or empty
        string parent;
        // Bytes in one, header included
        u32 size;
        bool value_type;
    }

    struct Field {
        string name;
        // Like `System.Int32` or `System.Collections.Generic.List<Game.Item>`
        string type;
        // From the object's start, header included, even in value types. Statics: from the class's
        // static data, which `staticAddress` adds in.
        usize offset;
        bool is_static;
        // A `const`, with no storage
        bool literal;
    }

    struct Method {
        string name;
        string return_type;
        // Each parameter's type
        []string params;
        bool is_static;
    }
}

trait Managed {
    // `none` till it's running
    Kind runtimeKind();
    // Waits till the game's started its runtime, after plugins load. `NotRunning` if it has none.
    async void!ManagedError running();
    // Loaded images, like `Assembly-CSharp.dll`
    []string!ManagedError images();
    // An image's classes by full name, nested ones too
    []string!ManagedError classes(string image);
    Class!ManagedError find(string class_name);
    // Its own fields, not its parents'
    []Field!ManagedError fields(string class_name);
    // Its own methods, not its parents'
    []Method!ManagedError methods(string class_name);
    // Looks in parents too
    usize!ManagedError fieldOffset(string class_name, string field);
    // Where a static is now. May run the static constructor. Salamander's built-in `Unsupported` for
    // thread statics and IL2CPP before Unity 2019 or so.
    usize!ManagedError staticAddress(string class_name, string field);
    // A method's code, with `params` parameters or any if -1. Looks in parents too. Mono compiles it if needed.
    usize!ManagedError findMethod(string class_name, string name, i32 params);
    // The native function behind an `extern` method, callable with its C signature, `this` first.
    // Unity's only on the game's main thread.
    usize!ManagedError icall(string class_name, string method);
    // The `System.Type` object for a class.
    usize!ManagedError typeObject(string class_name);
    // Calls `function`, taking nothing and giving a pointer-sized value, on Wraith's runtime thread.
    // Not for Unity's main-thread calls.
    usize!ManagedError callNative(usize function);
    // Calls a C# method by name, picking the best fitting overload. `target` is 0 for statics. Runs
    // here if the runtime knows this thread, else on Wraith's. Structs come back boxed. `.ctor` with
    // a 0 `target` makes a new object.
    Value!ManagedError invoke(string class_name, string method, usize target, []Value args);
    // Keeps the object from being collected till `release`. Hold anything kept past the call it came
    // from. Released when the plugin goes. Any thread, straight away.
    u32!ManagedError hold(usize object);
    // Fine to call twice.
    void release(u32 handle);
    // Where a held object is now, which only changes under CoreCLR. Any thread, straight away.
    usize!ManagedError heldAt(u32 handle);
    // The object's class's full name
    string!ManagedError classOf(usize object);
    // The `System.String` at `address`, as UTF-8
    string!ManagedError readString(usize address);
    // An instance field by name, parents included. Primitives and strings as themselves, structs as
    // the address of their bytes, the rest as objects. Any thread.
    Value!ManagedError getField(usize object, string field);
    // Sets one through the runtime so the GC sees it. Any thread, but Unity objects want the main thread.
    void!ManagedError setField(usize object, string field, Value value);
}
