// The free camera. A game or engine plugin hands Wraith the game's camera each frame, and Wraith
// does the rest, including Photo mode. Any thread.

namespace Wraith;

namespace FreeCamera {
    enum Axis : u8 { pos_y, neg_y, pos_z, neg_z, pos_x, neg_x }

    // How the game's world is laid out, so moving and looking go the right way.
    struct World {
        Axis up;
        Axis look;
        bool left_handed;
        // Game units per metre, like 100 in Unreal
        f32 metre;
    }

    // Which of the camera's fields say where it points.
    enum Aim : u8 {
        // At `target`, tipped by `roll`
        target,
        // By `rotation`
        rotation,
    }

    struct State {
        Vec3 position;
        Aim aim;
        Vec3 target;
        Vec3 up;
        Quat rotation;
        f32 roll;
        // In radians
        f32 fov;
    }
}

trait FreeCamera {
    // A lease on the game's camera, see `Lease`. Only the holder's `setWorld` and `camera` count.
    Lease!LeaseError claim(keep ?Lease.Changed changed);
    // Once, before the first `camera`, before or after claiming. Kept till it gets the lease.
    void setWorld(World world);
    // Every frame from where the game sets its camera; Wraith overrides it while the free camera's on.
    // `id` is its id in `cameras`, or 0. A new id carries on from that camera. Lease holder only.
    void camera(u64 id, inout State camera);
    // Turns the free camera on and orbits it round `point`.
    void focus(Vec3 point);
    bool active();

    // For games with several cameras: `set` them on `cameras`, put `wantedCamera` on screen each
    // frame, hand `camera` whichever's shown, and restore the game's own when the free camera leaves.

    // The plugin's camera list in Photo mode's Camera panel. `add` and `rename` give it those buttons,
    // and only count the first time. `add` makes one at the view and `select`s it.
    ItemList cameras(keep ?ItemList.Add add, keep ?ItemList.Rename rename);
    // The camera the player wants on screen, by its id in `cameras`, or 0 for the game's own. Lease holder only.
    u64 wantedCamera();
}
