// The free camera. A game's plugin, or its engine's, hands Wraith the game's camera each frame from
// wherever the game sets it, and Wraith does the rest: flying, orbiting, the keys and settings, and
// Photo mode. Any thread.

namespace Wraith;

namespace FreeCamera {
    // An axis and which way along it.
    enum Axis : u8 { pos_y, neg_y, pos_z, neg_z, pos_x, neg_x }

    // How the game's world is laid out, so moving and looking go the right way.
    struct World {
        Axis up;
        Axis look;
        bool left_handed;
        // How many of the game's units make a metre, like 100 in Unreal
        f32 metre;
    }

    // Which of the camera's fields say where it points.
    enum Aim : u8 {
        // at `target`, a point in the world, tipped by `roll`
        target,
        // by `rotation`, a quaternion as x, y, z, w
        rotation,
    }

    // The game's camera.
    struct State {
        Vec3 position;
        Aim aim;
        Vec3 target;
        Vec3 up;
        Quat rotation;
        f32 roll;
        // In radians
        f32 fov;
    }
}

trait FreeCamera {
    // Once, before the first `camera`.
    void setWorld(World world);
    // Every frame from where the game sets its camera, like a hook after its camera update. While
    // the free camera's on, Wraith changes it to its own. Otherwise it's left as it is.
    void camera(inout State camera);
    // Turns the free camera on if it isn't, and orbits it round `point`, in the world.
    void focus(Vec3 point);
    // Whether the free camera's on.
    bool active();
}
