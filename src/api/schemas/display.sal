// What the game shows: its camera's view, output encoding, frame captures and frame times.

namespace Wraith;

// 4 bytes a pixel except rgba16f's 8.
enum PixelFormat : u8 {
    unknown,
    rgba8,
    bgra8,
    // Alpha is junk
    bgrx8,
    // 32 bits from the low bits up: 10 red, 10 green, 10 blue, 2 alpha
    rgb10a2,
    // Same with red and blue swapped
    bgr10a2,
    // Half floats, usually scRGB
    rgba16f,
}

enum ColorSpace : u8 {
    // SDR, sRGB-encoded
    srgb,
    // Linear Rec.709, 1.0 is 80 nits, can go past 0..1
    scrgb,
    // Rec.2020 with PQ, 1.0 is 10000 nits
    hdr10,
}

enum GraphicsApi : u8 { unknown, d3d9, d3d10, d3d11, d3d12, vulkan, opengl }

namespace Capture {
    enum Point : u8 {
        // Before the overlay draws
        before_overlay,
        // With the overlay, as presented
        after_overlay,
    }
}

// A copy of a frame, owned by whoever takes it.
struct Capture {
    u32 width;
    u32 height;
    // Bytes per row, top row first. Can be more than the pixels need.
    u32 pitch;
    PixelFormat format;
    // The API's own format: DXGI_FORMAT, VkFormat, D3DFORMAT or a GL internal format
    u32 native_format;
    GraphicsApi graphics_api;
    ColorSpace color_space;
    // SDR white on the game's display, in nits
    f32 sdr_white_nits;
    blob pixels;
}

error CaptureError {
    NoFrames = 1,
    // This game's graphics can't be copied, or the overlay can't draw
    Failed,
    // Its wraith.json doesn't list "capture" in "permissions"
    NotDeclared,
}

namespace Display {
    // The game camera's view, for drawing over the world. Row vectors, D3D style: clip = [x y z 1] *
    // view * projection, looking down +z, depth 0 near to 1 far, clip y up.
    struct View {
        Mat4 viewMatrix;
        Mat4 projection;
        // False till a plugin sets one, or once the last is over a second old
        bool known;
    }

    struct Stats {
        // What these cover. Less than the window early on or after a reset.
        f32 window_seconds;
        u32 frames;
        // From the average frame time
        f32 fps;
        f32 avg_ms;
        f32 min_ms;
        f32 max_ms;
        f32 p50_ms;
        f32 p95_ms;
        f32 p99_ms;
        // The fps at the 99th and 99.9th percentile frame times
        f32 low_1_fps;
        f32 low_01_fps;
        // Frames over `hitch_factor` times the median
        u32 hitches;
        f32 hitch_factor;
        // Since the game started or the stats were reset
        u64 total_frames;
        f32 total_avg_ms;
        f32 total_min_ms;
        f32 total_max_ms;
    }
}

trait Display {
    // A lease on the view and output color space, see `Lease`. Only the holder's `setView` and `setColorSpace` count.
    Lease!LeaseError claimView(keep ?Lease.Changed changed);
    // Each frame from the view's holder, after the free camera has moved it. Any thread.
    void setView(Mat4 view, Mat4 projection);
    // The last view set. Any thread.
    View gameView();
    // How the game's output is encoded, for where the swap chain can't say. The swap chain's own
    // setting wins. Kept till it gets the lease, and gone with it. Any thread.
    void setColorSpace(ColorSpace space);
    // The next frame drawn at `point`. Any thread.
    async Capture!CaptureError capture(Capture.Point point);
    // Updated a few times a second, so cheap every frame. Any thread.
    Stats frameStats();
    // Newest frame times in ms, oldest first. Good till the thread's next call into Wraith. Any thread.
    []f32 times();
}
