// Tweaks a plugin lists with the project's own, and switching any tweak by name.

namespace Wraith;

error TweakError {
    // Empty, too long, or not letters, digits, `_`, `-` and `.`
    InvalidId = 1,
    // A key that isn't one, or a field with no name
    InvalidDefinition,
    // No tweak or group's saved by that name
    NotFound,
    Failed,
}

namespace Tweaks {
    enum Mode : u8 {
        // On until it's turned off
        toggle,
        // Runs once, then everything it did goes back
        action,
        // An action that opens something, like a window. Shown with an open button.
        open,
    }

    enum FieldType : u8 { f64, f32, i64, i32, i16, i8, u64, u32, u16, u8, bool }

    struct Choice {
        f64 value;
        string label;
    }

    // Like a tweak's `@data`, but no memory: changes go to the handler.
    struct Field {
        string name;
        FieldType type;
        f64 value;
        // Empty shows the name
        string label;
        // A checkbox for 0 and 1
        bool toggle;
        bool hex;
        // Limits, each only with its `has_`
        bool has_min;
        f64 min;
        bool has_max;
        f64 max;
        // Flips a `toggle`, like `F9`. Empty is none.
        string key;
        // A dropdown
        []Choice choices;
    }

    struct Definition {
        // Kept with the user's settings
        string id;
        // Empty shows the id.
        string title;
        // Like `Ctrl+F8`. Empty is none.
        string key;
        Mode mode;
        []Field fields;
    }

    enum EventKind : u8 {
        // Turned on, or an action run. Each field comes as a `changed` just before.
        on,
        off,
        // A field's value, before `on` or when it changes while on
        changed,
    }

    struct Event {
        EventKind kind;
        // For `changed`
        string field;
        f64 value;
    }

    // On the render thread. Failing an `on` keeps it off and shows the error (a script's throw).
    fn void!TweakError Handler(Event event);

    // A tweak went on or off, by saved name like `kai/Combat/Max bravery`. Render thread, after the frame it changed.
    fn void Switched(string name, bool on);

    trait SwitchSubscription {
        // Fine to call twice, or from inside one.
        void cancel();
    }
}

trait Tweaks {
    // Until removed or the plugin goes. The same id replaces it and keeps it on.
    void!TweakError add(Definition definition, keep Handler handler);
    // Like `add`, under a heading like `Combat`. Empty is none.
    void!TweakError addIn(string section, Definition definition, keep Handler handler);
    // Waits for its handler if it's running, unless called from inside it.
    void remove(string id);
    // A toggle that enables `hook` while on. The definition's mode and fields are ignored.
    void!TweakError addHook(string section, Definition definition, keep Hook hook);
    // An open button that opens and focuses `window`.
    void!TweakError addOpener(string section, Definition definition, keep Window window);
    // Whether a tweak's box is on, by saved name. A group's own box, not its contents. Any thread.
    bool!TweakError isOn(string name);
    // Switches it next frame, like clicking its box. Fine from inside any handler.
    void!TweakError setOn(string name, bool on);
    // Hears every tweak go on or off. Gone with the plugin.
    SwitchSubscription!TweakError onSwitched(keep Switched handler);
}
