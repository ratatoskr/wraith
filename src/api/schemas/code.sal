// Assembly, patches and code memory, all put back when the plugin goes. Any thread.
// Returned text and slices are good till the thread's next call into Wraith.

namespace Wraith;

error CodeError {
    InvalidAsm = 1,
    TooLong,
    Unreadable,
    // `expect` didn't match what's there
    UnexpectedBytes,
    // An `expect` that doesn't parse
    InvalidPattern,
    // Someone else hooked or patched it
    AlreadyHooked,
    // It changed since it was looked at
    TargetModified,
    // A size that ends inside an instruction
    SplitsInstruction,
    // No room near enough
    OutOfReach,
    // Not code
    InvalidInstruction,
    Failed,
}

namespace Patch {
    struct Options {
        // Bytes replaced, ending between instructions. 0 is what `expect` covers, or the one instruction.
        u32 size;
        // Bytes like `89 83 ?? ??` or asm like `cmp ecx, eax` that must be there first. Empty skips the check.
        string expect;
        // Starts off rather than on
        bool disabled;
        // Before the address list's
        []Addresses.Name names;
    }
}

trait Patch {
    void!CodeError enable();
    void!CodeError disable();
    // Puts the code back for good. Fine to call twice.
    void destroy();
}

namespace Code {
    struct Instruction {
        usize address;
        u32 length;
        []u8 bytes;
        // Intel syntax
        string text;
    }

    // A name for somewhere in data `place` places.
    struct PlaceName {
        string name;
        // Bytes into the data
        u32 offset;
    }

    struct PlaceData {
        u32 size;
        // 0 is 8
        u32 alignment;
        // Names its code can use
        []PlaceName names;
    }

    struct PlaceCode {
        usize target;
        string source;
        // Goes before the instruction like `inject`, else replaces code like `patch`
        bool inject;
        // Like `Patch.Options`
        u32 size;
        string expect;
        // After the data's and before the address list's
        []Addresses.Name names;
    }

    struct PlaceRequest {
        // What the data's near when no code jumps to it
        usize near;
        []PlaceData data;
        []PlaceCode code;
    }

    struct Placed {
        // Where each data went, in order
        []usize data;
        // Each code's patch, in order. They start off.
        []Patch code;
    }
}

trait Code {
    // `source` as if it were at `address`.
    []u8!CodeError assemble(string source, usize address);
    // Replaces code at `target` with asm, in place or in a cave. `jmp original` runs it as it was.
    Patch!CodeError patch(usize target, string source, Patch.Options options);
    // Writes exactly `bytes` over the code at `target`.
    Patch!CodeError patchBytes(usize target, []u8 bytes, Patch.Options options);
    // Runs asm in a cave before the instruction at `target`. `jmp resume` skips it. Only `disabled` and `names` count.
    Patch!CodeError inject(usize target, string source, Patch.Options options);
    // RWX memory, within a jump of `near` unless it's 0.
    usize!CodeError alloc(u32 size, usize near);
    void free(usize address);
    // Data and the code that reads it placed together so the code always reaches it. Nothing's left if it fails.
    Placed!CodeError place(PlaceRequest request);
    // Up to `count` instructions (0 is 1), stopping early at unreadable memory or non-code.
    []Instruction!CodeError disassemble(usize address, u32 count);
    u32!CodeError instructionLength(usize address);
}
