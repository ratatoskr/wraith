// Posing characters' bones and blend shapes. A game or engine plugin hands Wraith each animated
// skeleton and its shapes, and Wraith applies the player's edits and does the rest. Any thread.

namespace Wraith;

namespace Posing {
    struct Bone {
        // Edits are kept by it, so keep it stable across frames
        string name;
        // Its parent's index, which must come before it, or -1
        i32 parent;
    }

    // An actor's skeleton, this frame.
    struct Skeleton {
        // Stable while the actor's around, like its address
        u64 id;
        // Shown in the list of actors
        string name;
        []Bone bones;
        // From the bones' space to the world's, or the identity if they're in the world already
        Mat4 to_world;
    }

    // One blend shape, or morph target, on one of an actor's meshes.
    struct Shape {
        // Edits are kept by it and its mesh, so keep both stable
        string name;
        // Which mesh it's on, like the face or the body
        string mesh;
    }
}

trait Posing {
    // A lease on posing the game's characters, see `Lease`. Only the holder's skeletons are posed.
    Lease!LeaseError claim(keep ?Lease.Changed changed);
    // It holds the lease and posing's on. When false the game can skip building skeletons.
    bool active();
    // Every frame per actor, after animation, IK and physics and before anything follows it.
    // `matrices` has one per bone, row-vector style, changed in place.
    void pose(Skeleton skeleton, Mat4* matrices);
    // Every frame per actor with shapes, after `pose` and before skinning. `weights` has one per
    // shape, 0 to 1, changed in place. `actor` is the skeleton's id.
    void shapes(u64 actor, []Shape list, f32* weights);
    // Whether the player's picked or edited `actor`, so the game can animate it in full.
    bool wanted(u64 actor);
}
