// Named script source that scripts `require`, shared between plugins.

namespace Wraith;

// Names are letters, digits, `_`, `-` and `.`, up to 64.
error LibraryError {
    InvalidName = 1,
    NotFound,
    // There is one, but not for that language
    NoSource,
    // Someone else has one by that name and language
    Taken,
    TooBig,
    Failed,
}

trait Libraries {
    // For a language like "lua" or "js". Good till the thread's next call into Wraith.
    string!LibraryError get(string name, string language);
    // Until the plugin goes. The same name and language replaces it.
    void!LibraryError add(string name, string language, string source);
}
