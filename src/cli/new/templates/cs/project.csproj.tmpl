<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
{{runtime}}
    <PublishDir>dist/</PublishDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**</DefaultItemExcludes>
    <!-- The WRAITH environment variable can point at a wraith.exe -->
    <Wraith Condition="'$(Wraith)' == ''">wraith</Wraith>
  </PropertyGroup>

  <ItemGroup>
    <None Update="wraith.json;schemas/*.sal" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Wraith's API and the schemas as C#, in .wraith/cs. Each build, since only what changed is written:
       Wraith's API comes with the wraith launcher, and the plugins it depends on have schemas too -->
  <Target Name="WraithTypes" BeforeTargets="BeforeBuild">
    <Exec Command="&quot;$(Wraith)&quot; sdk cs types --pointer-size {{pointer_size}}" />
  </Target>
  <Target Name="WraithSources" AfterTargets="WraithTypes" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Compile Include=".wraith/cs/*.cs" />
    </ItemGroup>
  </Target>
</Project>
