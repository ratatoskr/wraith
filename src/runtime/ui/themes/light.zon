        .scrollbar_grab_hovered = .{ 0.675, 0.690, 0.745, 1.00 },
        .scrollbar_grab_active = .{ 0.612, 0.627, 0.690, 1.00 },

        .check_mark = .{ 0.533, 0.224, 0.937, 1.00 },
