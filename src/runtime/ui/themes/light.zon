// Catppuccin Latte (catppuccin.com, MIT), Dark's light twin with the same sizes
.{
    .name = "Light",
    .base = .light,
    .style = .{
        .window_padding = .{ 10.0, 10.0 },
        .frame_padding = .{ 8.0, 4.0 },
        .cell_padding = .{ 6.0, 3.0 },
        .item_spacing = .{ 8.0, 6.0 },
        .item_inner_spacing = .{ 6.0, 4.0 },
