root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.toml]
indent_style = space
indent_size = 4
max_line_length = off

[*.{html,js,ts,scss,css,json,yml,yaml,ksy}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
